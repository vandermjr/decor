<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Decor.AvaloniaUI.Icons"
    xmlns:controls="using:Decor.AvaloniaUI.Controls"
    x:Class="Decor.AvaloniaUI.App"
    RequestedThemeVariant="Dark">

<Application.Resources>
    <ResourceDictionary>
        <controls:DecorGridHeader x:Key="DecorGridHeaderTemplate" />
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="DecorScrollTrackBrush">#E2E5E9</SolidColorBrush>
                <SolidColorBrush x:Key="DecorScrollThumbBrush">#A5ADB8</SolidColorBrush>
                <SolidColorBrush x:Key="DecorWindowBackgroundBrush">#E8EBEF</SolidColorBrush>
                <SolidColorBrush x:Key="DecorSurfaceBrush">#F5F6F8</SolidColorBrush>
                <SolidColorBrush x:Key="DecorSurfaceRaisedBrush">#FFFFFF</SolidColorBrush>
                <SolidColorBrush x:Key="DecorControlBrush">#FFFFFF</SolidColorBrush>
                <SolidColorBrush x:Key="DecorBorderBrush">#CBD1D9</SolidColorBrush>
                <SolidColorBrush x:Key="DecorTextBrush">#30363E</SolidColorBrush>
                <SolidColorBrush x:Key="DecorTextMutedBrush">#68717D</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush">#F0F2F5</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush">#30363E</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridColumnHeaderHoveredBackgroundBrush">#E8ECF1</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush">#DFE5ED</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridGridLinesBrush">#E4E7EB</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor">#F3F6FA</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush">#DFEDF9</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush">#D5E7F6</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush">#DFEDF9</SolidColorBrush>
                <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush">#D5E7F6</SolidColorBrush>
                <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
                <SolidColorBrush x:Key="DecorAccentBrush">#2074B8</SolidColorBrush>
                <SolidColorBrush x:Key="DecorAccentHoverBrush">#185F9A</SolidColorBrush>
                <SolidColorBrush x:Key="DecorSelectionForegroundBrush">#FFFFFF</SolidColorBrush>
                <SolidColorBrush x:Key="DecorDangerBrush">#B32D35</SolidColorBrush>
                <SolidColorBrush x:Key="DecorEditIndicatorBrush">#D99A00</SolidColorBrush>
                <SolidColorBrush x:Key="DecorAddIndicatorBrush">#218739</SolidColorBrush>
                <SolidColorBrush x:Key="DecorOverlayBrush">#66000000</SolidColorBrush>
                <FontFamily x:Key="DecorFontFamily">Noto Sans, Segoe UI, sans-serif</FontFamily>
                <x:Double x:Key="DecorFontSizeBase">13</x:Double>
                <x:Double x:Key="DecorFontSizeSmall">10</x:Double>
                <x:Double x:Key="DecorFontSizeCaption">11</x:Double>
                <x:Double x:Key="DecorFontSizeSection">17</x:Double>
                <x:Double x:Key="DecorFontSizeTitle">22</x:Double>
                <x:Double x:Key="DecorFontSizeDisplay">28</x:Double>
                <FontWeight x:Key="DecorFontWeightBase">Normal</FontWeight>
                <FontWeight x:Key="DecorFontWeightHeading">SemiBold</FontWeight>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="DecorScrollTrackBrush">#272B30</SolidColorBrush>
                <SolidColorBrush x:Key="DecorScrollThumbBrush">#68727E</SolidColorBrush>
                <SolidColorBrush x:Key="DecorWindowBackgroundBrush">#191B1E</SolidColorBrush>
                <SolidColorBrush x:Key="DecorSurfaceBrush">#222529</SolidColorBrush>
                <SolidColorBrush x:Key="DecorSurfaceRaisedBrush">#2C3035</SolidColorBrush>
                <SolidColorBrush x:Key="DecorControlBrush">#272B30</SolidColorBrush>
                <SolidColorBrush x:Key="DecorBorderBrush">#3B4046</SolidColorBrush>
                <SolidColorBrush x:Key="DecorTextBrush">#E3E7EC</SolidColorBrush>
                <SolidColorBrush x:Key="DecorTextMutedBrush">#AAB4C0</SolidColorBrush>
                <SolidColorBrush x:Key="DecorAccentBrush">#3D94D1</SolidColorBrush>
                <SolidColorBrush x:Key="DecorAccentHoverBrush">#55A7E0</SolidColorBrush>
                <SolidColorBrush x:Key="DecorSelectionForegroundBrush">#FFFFFF</SolidColorBrush>
                <SolidColorBrush x:Key="DecorDangerBrush">#E16B73</SolidColorBrush>
                <SolidColorBrush x:Key="DecorEditIndicatorBrush">#F3C969</SolidColorBrush>
                <SolidColorBrush x:Key="DecorAddIndicatorBrush">#55B96B</SolidColorBrush>
                <SolidColorBrush x:Key="DecorOverlayBrush">#99000000</SolidColorBrush>
                <FontFamily x:Key="DecorFontFamily">Noto Sans, Segoe UI, sans-serif</FontFamily>
                <x:Double x:Key="DecorFontSizeBase">13</x:Double>
                <x:Double x:Key="DecorFontSizeSmall">10</x:Double>
                <x:Double x:Key="DecorFontSizeCaption">11</x:Double>
                <x:Double x:Key="DecorFontSizeSection">17</x:Double>
                <x:Double x:Key="DecorFontSizeTitle">22</x:Double>
                <x:Double x:Key="DecorFontSizeDisplay">28</x:Double>
                <FontWeight x:Key="DecorFontWeightBase">Light</FontWeight>
                <FontWeight x:Key="DecorFontWeightHeading">Light</FontWeight>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
</Application.Resources>

<Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource DecorWindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DecorFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DecorFontSizeBase}" />
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DecorFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DecorFontSizeBase}" />
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
    </Style>
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource DecorSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DecorFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DecorFontSizeBase}" />
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DecorFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DecorFontSizeBase}" />
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="MenuItem /template/ ContentPresenter">
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
    </Style>
    <Style Selector="MenuItem /template/ ContentPresenter TextBlock">
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource DecorControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource DecorControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}" />
    </Style>
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Navigation.Dropdown}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DecorFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DecorFontSizeBase}" />
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.search-button">
        <Setter Property="Width" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="ToolTip.Tip" Value="Pesquisar" />
        <Setter Property="AutomationProperties.Name" Value="Pesquisar" />
    </Style>
    <Style Selector="Button.clear-search-button">
        <Setter Property="Width" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="ToolTip.Tip" Value="Limpar pesquisa" />
        <Setter Property="AutomationProperties.Name" Value="Limpar pesquisa" />
    </Style>
    <Style Selector="Button.grid-page-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Width" Value="26" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip.ShowDelay" Value="400" />
    </Style>
    <Style Selector="Button.grid-page-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource DecorScrollTrackBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.grid-page-button:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.grid-page-button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox.grid-page-size">
        <Setter Property="ToolTip.ShowDelay" Value="400" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource DecorFontSizeBase}" />
    </Style>
    <Style Selector="ComboBox.grid-page-size:pointerover">
        <Setter Property="Background" Value="{DynamicResource DecorScrollTrackBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox.grid-page-size:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource DecorScrollTrackBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter TextBlock">
        <Setter Property="FontWeight" Value="{DynamicResource DecorFontWeightBase}" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource DecorControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Height" Value="23" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DecorSelectionForegroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DecorSelectionForegroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DecorAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorSelectionForegroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DecorAccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorSelectionForegroundBrush}" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DecorTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGridColumnHeader /template/ ContentPresenter">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- DecorGridHeader draws the sort indicator on the right; the native glyph and its reserved width are disabled. -->
    <Style Selector="DataGridColumnHeader /template/ Path#SortIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DataGridColumnHeader:sortascending /template/ Path#SortIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DataGridColumnHeader:sortdescending /template/ Path#SortIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
</Application.Styles>

</Application>
