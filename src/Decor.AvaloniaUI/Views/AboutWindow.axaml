<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Decor.AvaloniaUI.Views"
        x:Class="Decor.AvaloniaUI.Views.AboutWindow"
        Title="Sobre o Sistema" Width="620" Height="470"
        MinWidth="480" MinHeight="400" CanResize="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="*,Auto">
    <views:AboutView/>
    <Button Grid.Row="1" Content="Fechar" HorizontalAlignment="Right" Margin="24,0,24,20" Click="Close_Click" IsCancel="True"/>
  </Grid>
</Window>