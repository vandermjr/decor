<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.UnitsOfMeasureView"
             x:DataType="vm:UnitsOfMeasureViewModel">
  <Grid RowDefinitions="Auto,*" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12" IsVisible="{Binding !IsEditing}">
      <controls:DecorSearchField x:Name="SearchTextBox" TabIndex="0" Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="Pesquisar por código ou descrição" SearchCommand="{Binding SearchCommand}"
                                 ClearCommand="{Binding ClearSearchCommand}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding NewCommand}" IsVisible="{Binding CanNew}" Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{DynamicResource DecorAddIndicatorBrush}" Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Nova unidade" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Edit}" Fill="{DynamicResource DecorEditIndicatorBrush}" Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Editar" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Panel Grid.Row="1">
      <controls:DecorDataGridControl x:Name="UnitsGrid" PaginationSource="{Binding}" DefaultSortMemberPath="Code"
                                     ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding !IsEditing}"/>
      <Grid RowDefinitions="*,Auto" IsVisible="{Binding IsEditing}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,0,20,0" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="Informações da Unidade de Medida" FontSize="{DynamicResource DecorFontSizeTitle}"
                       FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12,8">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Código" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding UnitCodeDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsActive, Mode=TwoWay}" IsEnabled="{Binding CanChangeActive}"
                              OnContent="Ativo" OffContent="Inativo" MinWidth="115"/>
              </Grid>
            </Border>
            <StackPanel Spacing="4">
              <TextBlock Text="Código da unidade" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox x:Name="CodeTextBox" Text="{Binding Code}" MaxLength="10" controls:DecorRequiredField.IsRequired="True"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Descrição" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox Text="{Binding Description}" MaxLength="100" controls:DecorRequiredField.IsRequired="True"/>
            </StackPanel>
            <CheckBox Content="Permite quantidades fracionadas" IsChecked="{Binding AllowsFraction}"/>
            <TextBlock Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding SaveCommand}" IsVisible="{Binding CanSave}" Classes="decor-action">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{DynamicResource DecorAccentBrush}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Classes="decor-action">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{DynamicResource DecorDangerBrush}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Panel>
  </Grid>
</UserControl>