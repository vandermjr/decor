<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Decor.AvaloniaUI.Controls"
    xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
    xmlns:dto="using:Decor.Core.DTOs"
    xmlns:icons="using:Decor.AvaloniaUI.Icons"
    x:Class="Decor.AvaloniaUI.Views.ProductsView"
    x:DataType="vm:ProductsViewModel">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ErrorBrush">#FFB3261E</SolidColorBrush>
    <TreeDataTemplate x:Key="ClassificationTreeTemplate" DataType="{x:Type vm:ClassificationTreeNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
        <Border Width="4" Height="18" CornerRadius="2" Background="{Binding LevelBrush}"/>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding LevelName}" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </TreeDataTemplate>
    <ControlTheme x:Key="ClassificationTreeItemTheme" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
      <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
    </ControlTheme>
    <Flyout x:Key="ClassificationFilterFlyout" Placement="BottomEdgeAlignedRight" Opened="ClassificationFilterFlyout_Opened">
      <Border Classes="column-menu" BorderThickness="1" CornerRadius="5" Padding="12" Width="330" MaxHeight="480">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Filtrar por classificação" FontWeight="{DynamicResource DecorFontWeightHeading}"/><TextBlock Text="Selecione uma classe, família, grupo ou subgrupo." FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Classes="decor-flyout-close" Click="CloseClassificationFilterFlyout_Click" ToolTip.Tip="Fechar"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/></Button></Grid>
          <TextBox Grid.Row="1" Text="{Binding ClassificationSearchText, Mode=TwoWay}" PlaceholderText="Pesquisar classificações"/>
          <TreeView Grid.Row="2" ItemsSource="{Binding FilteredClassificationTreeNodes}" SelectedItem="{Binding SelectedCatalogClassificationNode, Mode=TwoWay}" ItemTemplate="{StaticResource ClassificationTreeTemplate}" ItemContainerTheme="{StaticResource ClassificationTreeItemTheme}" MinHeight="190"/>
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding ClassificationFilterDisplay}" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Limpar" Command="{Binding ClearClassificationFilterCommand}" Classes="product-secondary-action"/>
            <Button Grid.Column="2" Content="OK" Classes="product-secondary-action" Click="ClassificationFilterConfirm_Click"/>
          </Grid>
        </Grid>
      </Border>
    </Flyout>
    <Flyout x:Key="CatalogIndicatorsFlyout" Placement="BottomEdgeAlignedRight">
      <Border Classes="column-menu" BorderThickness="1" CornerRadius="6" Padding="12" Width="250">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Personalizar indicadores" FontWeight="{DynamicResource DecorFontWeightHeading}"/><TextBlock Text="Escolha os dados exibidos neste resumo." FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Classes="decor-flyout-close" Click="CloseCatalogIndicatorsFlyout_Click" ToolTip.Tip="Fechar"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/></Button></Grid>
          <CheckBox Content="Produtos cadastrados" IsChecked="{Binding ShowTotalProductsIndicator, Mode=TwoWay}"/>
          <CheckBox Content="Produtos ativos" IsChecked="{Binding ShowActiveProductsIndicator, Mode=TwoWay}"/>
          <CheckBox Content="Produtos inativos" IsChecked="{Binding ShowInactiveProductsIndicator, Mode=TwoWay}"/>
          <CheckBox Content="Produtos sem estoque" IsChecked="{Binding ShowOutOfStockProductsIndicator, Mode=TwoWay}"/>
          <CheckBox Content="Produtos com estoque baixo" IsChecked="{Binding ShowLowStockProductsIndicator, Mode=TwoWay}"/>
        </StackPanel>
      </Border>
    </Flyout>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="PathIcon.catalog-total-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Common.Database}"/></Style>
    <Style Selector="PathIcon.catalog-active-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Common.Status}"/></Style>
    <Style Selector="PathIcon.catalog-empty-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Actions.Remove}"/></Style>
    <Style Selector="PathIcon.catalog-low-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Actions.Filter}"/></Style>
    <Style Selector="PathIcon.catalog-inactive-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Actions.Close}"/></Style>
    <Style Selector="PathIcon.product-placeholder-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Forms.Products}"/></Style>
    <Style Selector="Expander.catalog-summary /template/ ToggleButton">
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Padding" Value="6,0"/>
    </Style>
    <Style Selector="Border.catalog-indicator-card">
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Height" Value="140"/>
    </Style>
    <Style Selector="Border.catalog-indicator-icon">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="17"/>
    </Style>
    <Style Selector="Button.catalog-indicator-action">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Width" Value="220"/>
      <Setter Property="MinWidth" Value="220"/>
    </Style>
    <Style Selector="Button.catalog-indicator-action:pointerover Border.catalog-indicator-card">
      <Setter Property="BorderBrush" Value="{DynamicResource DecorAccentBrush}"/>
    </Style>
    <Style Selector="Button.catalog-carousel-navigation">
      <Setter Property="Width" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Height" Value="140"/>
      <Setter Property="Padding" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog DataGridRow">
      <Setter Property="MinHeight" Value="44"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog .grid-column-ProductID">
      <Setter x:SetterTargetType="TextBlock" Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog .grid-column-StockStatus">
      <Setter x:SetterTargetType="TextBlock" Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog .grid-column-ProductName">
      <Setter x:SetterTargetType="TextBlock" Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog .grid-column-AvailableStockQuantity">
      <Setter x:SetterTargetType="TextBlock" Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.quantity-field">
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
    </Style>
    <Style Selector="Border.quantity-field:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource DecorFieldFocusBrush}"/>
    </Style>
    <Style Selector="Button.product-secondary-action, ToggleButton.product-secondary-action">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
    </Style>
    <Style Selector="ToggleButton.product-secondary-action:checked">
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorAccentBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource CatalogActionBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource CatalogActionHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CatalogActionHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:focus">
      <Setter Property="Background" Value="{DynamicResource CatalogActionFocusBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorFieldFocusBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CatalogActionFocusBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorFieldFocusBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:pressed">
      <Setter Property="Background" Value="{DynamicResource CatalogActionPressedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:disabled">
      <Setter Property="Background" Value="{DynamicResource CatalogActionDisabledBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionDisabledForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionDisabledBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.column-menu">
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
    </Style>
    <Style Selector="Border.catalog-filter-chip">
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-filter-remove">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="MinHeight" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ProgressBar.product-stock-level">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Foreground" Value="{DynamicResource DecorStockLevelBrush}"/>
      <Setter Property="Background" Value="{DynamicResource DecorScrollTrackBrush}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="18">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" IsVisible="{Binding !IsEditing}">
      <StackPanel Spacing="4">
        <TextBlock Text="Catálogo de produtos" FontSize="{DynamicResource DecorFontSizeDisplay}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
        <TextBlock Text="Catálogo, preços e disponibilidade do estoque." FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="catalog-accent-action" TabIndex="1" Command="{Binding NewCommand}" IsVisible="{Binding CanNew}" Margin="12,0,0,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{DynamicResource CatalogActionForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
          <TextBlock Text="Novo produto" Foreground="{DynamicResource CatalogActionForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>
    <Grid x:Name="CatalogLayout" Grid.Row="1" RowDefinitions="Auto,Auto,*" ColumnSpacing="12" RowSpacing="12" IsVisible="{Binding !IsEditing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="0"/>
        <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>
      <Expander x:Name="CatalogSummaryExpander" Classes="catalog-summary" Grid.Row="0" Grid.Column="0" Header="Indicadores" IsExpanded="False" Expanded="CatalogSummaryExpander_Expanded" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="Panorama do catálogo" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <TextBlock Text="{Binding CatalogSummaryUpdatedDisplay}" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="product-secondary-action" Command="{Binding RefreshCatalogSummaryCommand}" IsEnabled="{Binding !IsCatalogSummaryLoading}" ToolTip.Tip="Atualizar indicadores">
              <PathIcon icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Refresh}" Width="16" Height="16" Foreground="{DynamicResource DecorTextMutedBrush}"/>
            </Button>
            <Button Grid.Column="2" Classes="product-secondary-action" Flyout="{StaticResource CatalogIndicatorsFlyout}" ToolTip.Tip="Escolher indicadores exibidos">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon icons:DecorIcon.Id="{x:Static icons:DecorIconId+Application.Settings}" Width="14" Height="14" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                <TextBlock Text="Indicadores" FontSize="{DynamicResource DecorFontSizeCaption}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <Grid IsVisible="{Binding IsCatalogSummaryLoading}" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
            <Border Classes="catalog-indicator-card"><StackPanel Spacing="10" VerticalAlignment="Center"><Border Height="10" Width="110" Background="{DynamicResource DecorScrollTrackBrush}" CornerRadius="5"/><Border Height="24" Width="64" Background="{DynamicResource DecorScrollTrackBrush}" CornerRadius="4"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="catalog-indicator-card"><StackPanel Spacing="10" VerticalAlignment="Center"><Border Height="10" Width="94" Background="{DynamicResource DecorScrollTrackBrush}" CornerRadius="5"/><Border Height="24" Width="74" Background="{DynamicResource DecorScrollTrackBrush}" CornerRadius="4"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="catalog-indicator-card"><StackPanel Spacing="10" VerticalAlignment="Center"><Border Height="10" Width="100" Background="{DynamicResource DecorScrollTrackBrush}" CornerRadius="5"/><Border Height="8" Background="{DynamicResource DecorScrollTrackBrush}" CornerRadius="4"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="catalog-indicator-card"><StackPanel Spacing="10" VerticalAlignment="Center"><Border Height="10" Width="88" Background="{DynamicResource DecorScrollTrackBrush}" CornerRadius="5"/><Border Height="8" Background="{DynamicResource DecorScrollTrackBrush}" CornerRadius="4"/></StackPanel></Border>
          </Grid>
          <Grid IsVisible="{Binding HasCatalogSummary}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Classes="catalog-carousel-navigation" Click="PreviousCatalogIndicator_Click" ToolTip.Tip="Indicadores anteriores" VerticalAlignment="Center">
              <Viewbox Width="28" Height="112" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"><PathIcon icons:DecorIcon.Id="{x:Static icons:DecorIconId+Navigation.PreviousPage}" Width="24" Height="24" Foreground="{DynamicResource DecorTextMutedBrush}"/></Viewbox>
            </Button>
            <ScrollViewer x:Name="CatalogSummaryCarousel" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel x:Name="CatalogSummaryLayout" Orientation="Horizontal" Spacing="12">
            <Button x:Name="TotalProductsIndicatorButton" Classes="catalog-indicator-action" MinWidth="0" Click="CatalogIndicatorCard_Click" Tag="" ToolTip.Tip="Mostrar todos os produtos no catálogo" IsVisible="{Binding ShowTotalProductsIndicator}">
            <Border Classes="catalog-indicator-card">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto">
                <TextBlock Text="VISÃO DO CATÁLOGO" TextWrapping="Wrap" FontSize="{DynamicResource DecorFontSizeCaption}" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                <Border Grid.Column="1" Classes="catalog-indicator-icon"><PathIcon Classes="catalog-total-icon" Width="17" Height="17" Foreground="{DynamicResource DecorAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Grid.Row="1" Text="{Binding TotalProductsDisplay}" FontSize="{DynamicResource DecorFontSizeDisplay}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="Ver todos os produtos  ›" TextWrapping="Wrap" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorAccentBrush}"/>
              </Grid>
            </Border>
            </Button>
            <Button x:Name="ActiveProductsIndicatorButton" Grid.Column="1" Classes="catalog-indicator-action" MinWidth="0" Click="CatalogIndicatorCard_Click" Tag="active" ToolTip.Tip="Mostrar produtos ativos no catálogo" IsVisible="{Binding ShowActiveProductsIndicator}">
            <Border Classes="catalog-indicator-card">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto">
                <TextBlock Text="ATIVAÇÃO" TextWrapping="Wrap" FontSize="{DynamicResource DecorFontSizeCaption}" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                <Border Grid.Column="1" Classes="catalog-indicator-icon"><PathIcon Classes="catalog-active-icon" Width="17" Height="17" Foreground="{DynamicResource DecorAddIndicatorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="{Binding ActiveProductsDisplay}" FontSize="{DynamicResource DecorFontSizeDisplay}" FontWeight="{DynamicResource DecorFontWeightHeading}"/><TextBlock Grid.Column="1" Text="{Binding ActiveProductsPercentageDisplay}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/></Grid><ProgressBar Maximum="100" Value="{Binding ActiveProductsPercentage}" Height="6" Foreground="{DynamicResource DecorAddIndicatorBrush}"/></StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding InactiveProductsDisplay, StringFormat='{}{0} inativos'}" IsVisible="{Binding ShowInactiveProductsIndicator}" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
              </Grid>
            </Border>
            </Button>
            <Button x:Name="OutOfStockProductsIndicatorButton" Grid.Column="2" Classes="catalog-indicator-action" MinWidth="0" Click="CatalogIndicatorCard_Click" Tag="out-of-stock" ToolTip.Tip="Mostrar produtos sem estoque no catálogo" IsVisible="{Binding ShowOutOfStockProductsIndicator}">
            <Border Classes="catalog-indicator-card">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto">
                <TextBlock Text="SEM ESTOQUE" TextWrapping="Wrap" FontSize="{DynamicResource DecorFontSizeCaption}" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                <Border Grid.Column="1" Classes="catalog-indicator-icon"><PathIcon Classes="catalog-empty-icon" Width="17" Height="17" Foreground="{DynamicResource DecorDangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Grid.Row="1" Text="{Binding OutOfStockProductsDisplay}" FontSize="{DynamicResource DecorFontSizeDisplay}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="Ver produtos que requerem reposição  ›" TextWrapping="Wrap" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorDangerBrush}"/>
              </Grid>
            </Border>
            </Button>
            <Button x:Name="LowStockProductsIndicatorButton" Grid.Column="3" Classes="catalog-indicator-action" MinWidth="0" Click="CatalogIndicatorCard_Click" Tag="low-stock" ToolTip.Tip="Mostrar produtos com estoque baixo no catálogo" IsVisible="{Binding ShowLowStockProductsIndicator}">
            <Border Classes="catalog-indicator-card">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto">
                <TextBlock Text="ESTOQUE BAIXO" TextWrapping="Wrap" FontSize="{DynamicResource DecorFontSizeCaption}" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                <Border Grid.Column="1" Classes="catalog-indicator-icon"><PathIcon Classes="catalog-low-icon" Width="17" Height="17" Foreground="{DynamicResource DecorEditIndicatorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Grid.Row="1" Text="{Binding LowStockProductsDisplay}" FontSize="{DynamicResource DecorFontSizeDisplay}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="Ver produtos abaixo do mínimo  ›" TextWrapping="Wrap" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorEditIndicatorBrush}"/>
              </Grid>
            </Border>
            </Button>
              </StackPanel>
            </ScrollViewer>
            <Button Grid.Column="2" Classes="catalog-carousel-navigation" Click="NextCatalogIndicator_Click" ToolTip.Tip="Próximos indicadores" VerticalAlignment="Center">
              <Viewbox Width="28" Height="112" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"><PathIcon icons:DecorIcon.Id="{x:Static icons:DecorIconId+Navigation.NextPage}" Width="24" Height="24" Foreground="{DynamicResource DecorTextMutedBrush}"/></Viewbox>
            </Button>
          </Grid>
        </StackPanel>
      </Expander>
      <Border x:Name="SearchToolsFrame" Grid.Row="1" Grid.Column="0" Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
        <StackPanel Spacing="8">
          <Grid x:Name="CatalogSearchActionsLayout" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="0"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:DecorSearchField x:Name="SearchTextBox" MinWidth="0" HorizontalAlignment="Stretch" TabIndex="0" Text="{Binding SearchText, Mode=TwoWay}"
                                       PlaceholderText="Pesquisar por código, produto, marca ou referência" SearchHelp="{x:Static controls:DecorSearchField.ProductSearchHelp}"
                                       SearchCommand="{Binding SearchCommand}" ClearCommand="{Binding ClearSearchCommand}"
                                       ShowSearchButton="False" ShowFilterButton="False" ShowLeadingSearchIcon="True" HighlightActionButtons="True"/>
            <Button x:Name="ClassificationFilterButton" Grid.Column="1" Classes="product-secondary-action" TabIndex="1" Margin="0"
                        Flyout="{StaticResource ClassificationFilterFlyout}" ToolTip.Tip="Filtrar por classificação">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Filter}" Fill="{DynamicResource DecorTextMutedBrush}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Filtrar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="ExportProductsButton" Grid.Column="2" Classes="product-secondary-action" TabIndex="2" IsEnabled="{Binding CanExport}" Margin="0" ToolTip.Tip="Exportar produtos encontrados">
              <Grid ColumnDefinitions="Auto,*,Auto" Width="112" ColumnSpacing="6" VerticalAlignment="Center">
                <Path Grid.Column="0" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Report}" Fill="{DynamicResource DecorTextMutedBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Exportar" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <PathIcon Grid.Column="2" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Navigation.Dropdown}" Foreground="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <PathIcon.RenderTransform>
                    <TranslateTransform Y="1"/>
                  </PathIcon.RenderTransform>
                </PathIcon>
              </Grid>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="4" MinWidth="190">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Exportar produtos" FontWeight="{DynamicResource DecorFontWeightHeading}"/><Button Grid.Column="1" Classes="decor-flyout-close" Click="CloseExportProductsFlyout_Click" ToolTip.Tip="Fechar"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/></Button></Grid>
                    <Button Content="CSV (.csv)" Classes="product-secondary-action" Click="ExportProductsCsvClicked" HorizontalAlignment="Stretch"/>
                    <Button Content="Excel 97-2003 (.xls)" Classes="product-secondary-action" Click="ExportProductsXlsClicked" HorizontalAlignment="Stretch"/>
                    <Button Content="Excel (.xlsx)" Classes="product-secondary-action" Click="ExportProductsXlsxClicked" HorizontalAlignment="Stretch"/>
                    <Button Content="OpenDocument (.odt)" Classes="product-secondary-action" Click="ExportProductsOdtClicked" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="ConfigureColumnsButton" Grid.Column="3" Classes="product-secondary-action" TabIndex="3" Click="ConfigureColumnsClicked" Margin="0" ToolTip.Tip="Ordenar colunas e escolher quais ficam visíveis">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Application.Settings}" Fill="{DynamicResource DecorTextMutedBrush}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Ordenar colunas" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <WrapPanel Orientation="Horizontal" IsVisible="{Binding HasActiveCatalogFilters}">
            <Border Classes="catalog-filter-chip" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,0" IsVisible="{Binding HasClassificationFilter}">
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MaxWidth="320" ClipToBounds="True">
                  <TextBlock Text="Classificação" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
                  <ItemsControl ItemsSource="{Binding ClassificationFilterPathSegments}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ClassificationPathSegment">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <Border Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                              <Ellipse Width="6" Height="6" Fill="{Binding LevelBrush}" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Name}" FontSize="{DynamicResource DecorFontSizeCaption}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                          <TextBlock Text="›" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="15" VerticalAlignment="Center" IsVisible="{Binding HasNext}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <Button Grid.Column="1" Classes="catalog-filter-remove" Command="{Binding ClearClassificationFilterCommand}"
                        ToolTip.Tip="Remover filtro de classificação" AutomationProperties.Name="Remover filtro de classificação">
                  <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="11" Height="11" Stretch="Uniform"/>
                </Button>
              </Grid>
            </Border>
            <Border Classes="catalog-filter-chip" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,0" IsVisible="{Binding HasCatalogIndicatorFilter}">
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                <TextBlock Text="{Binding CatalogIndicatorFilterDisplay}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="catalog-filter-remove" Command="{Binding ClearCatalogIndicatorFilterCommand}"
                        ToolTip.Tip="Remover filtro do indicador" AutomationProperties.Name="Remover filtro do indicador">
                  <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="11" Height="11" Stretch="Uniform"/>
                </Button>
              </Grid>
            </Border>
            <Border Classes="catalog-filter-chip" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,0" IsVisible="{Binding HasCatalogSort}">
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                <TextBlock Text="{Binding CatalogSortDisplay}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Classes="catalog-filter-remove" Click="ClearCatalogSortClicked"
                        ToolTip.Tip="Remover ordenação" AutomationProperties.Name="Remover ordenação">
                  <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="11" Height="11" Stretch="Uniform"/>
                </Button>
              </Grid>
            </Border>
          </WrapPanel>
        </StackPanel>
      </Border>

    <!-- DataGrid ou Formulário (alternância) -->
        <Border x:Name="ProductsGridFrame" Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource DecorSurfaceRaisedBrush}">
          <controls:DecorDataGridControl x:Name="ProductsGrid" Classes="stock-catalog" FrameBorderThickness="0" PaginationSource="{Binding}" DefaultSortMemberPath="ProductID" ItemsSource="{Binding Products}"
                SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        </Border>
        <Border x:Name="ProductDetailsPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" MinWidth="380" MaxWidth="460" HorizontalAlignment="Stretch" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource DecorSurfaceRaisedBrush}" Padding="14">
          <Grid>
            <StackPanel IsVisible="{Binding !HasSelectedProduct}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="240">
              <PathIcon Classes="product-placeholder-icon" Width="38" Height="38" Foreground="{DynamicResource DecorTextMutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Selecione um produto" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock Text="Os dados do produto selecionado aparecem aqui." Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <ScrollViewer IsVisible="{Binding HasSelectedProduct}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                  <Border Width="96" Height="96" CornerRadius="6" Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1">
                    <PathIcon Classes="product-placeholder-icon" Width="34" Height="34" Foreground="{DynamicResource DecorTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="{Binding SelectedProduct.ProductName}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" TextWrapping="Wrap" MaxLines="3"/>
                    <TextBlock Text="{Binding SelectedProductCodeDisplay, StringFormat='Código {0}'}" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                    <TextBlock Text="{Binding SelectedProductCategoryDisplay}" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedProduct.BrandName}" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                    <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Background="{DynamicResource DecorSurfaceBrush}" IsVisible="{Binding IsSelectedProductActive}">
                      <TextBlock Text="{Binding SelectedProductStateDisplay}" Foreground="{DynamicResource DecorAddIndicatorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                    </Border>
                    <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Background="{DynamicResource DecorSurfaceBrush}" IsVisible="{Binding IsSelectedProductInactive}">
                      <TextBlock Text="{Binding SelectedProductStateDisplay}" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                    </Border>
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Preço de venda" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                    <TextBlock Text="{Binding SelectedSalePriceDisplay}" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3" IsVisible="{Binding HasSelectedCostPrice}" VerticalAlignment="Center">
                    <TextBlock Text="Custo" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                    <TextBlock Text="{Binding SelectedCostPriceDisplay}" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <Border Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Disponível" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedAvailableStockDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                      </StackPanel>
                      <Border Grid.Column="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource DecorSurfaceRaisedBrush}" IsVisible="{Binding IsSelectedStockPositive}">
                        <TextBlock Text="{Binding SelectedStockStatusDisplay}" Foreground="{DynamicResource DecorAddIndicatorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                      </Border>
                      <Border Grid.Column="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource DecorSurfaceRaisedBrush}" IsVisible="{Binding IsSelectedStockWarning}">
                        <TextBlock Text="{Binding SelectedStockStatusDisplay}" Foreground="{DynamicResource DecorEditIndicatorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                      </Border>
                      <Border Grid.Column="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource DecorSurfaceRaisedBrush}" IsVisible="{Binding IsSelectedStockNegative}">
                        <TextBlock Text="{Binding SelectedStockStatusDisplay}" Foreground="{DynamicResource DecorDangerBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                      </Border>
                      <Border Grid.Column="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource DecorSurfaceRaisedBrush}" IsVisible="{Binding IsSelectedStockMadeToOrder}">
                        <TextBlock Text="{Binding SelectedStockStatusDisplay}" Foreground="{DynamicResource DecorAccentBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                      </Border>
                    </Grid>
                    <ProgressBar Classes="product-stock-level" Minimum="0" Maximum="100" Value="{Binding SelectedStockLevelValue}" IsVisible="{Binding HasSelectedStockMinimum}"/>
                    <TextBlock Text="{Binding SelectedStockLevelDescription}" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                  </StackPanel>
                </Border>
                <Button Classes="catalog-accent-action" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Edit}" Fill="{DynamicResource CatalogActionForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
                    <TextBlock Text="Editar produto" Foreground="{DynamicResource CatalogActionForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TabControl MinHeight="180">
                  <TabItem Header="Resumo" FontSize="{DynamicResource DecorFontSizeBase}">
                    <StackPanel Spacing="10" Margin="8,12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Código de barras" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedBarcodeDisplay}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Aquisição" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedAcquisitionModeDisplay}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Observações" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedObservationsDisplay}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </TabItem>
                  <TabItem Header="Especificações" FontSize="{DynamicResource DecorFontSizeBase}">
                    <StackPanel Spacing="10" Margin="8,12">
                      <StackPanel Spacing="3"><TextBlock Text="Dimensões" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedDimensionsDisplay}" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="Unidade de medida" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedStockUnitDisplay}" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="Referência do fabricante" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedManufacturerReferenceDisplay}" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="Referência auxiliar" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedAuxiliaryReferenceDisplay}" TextWrapping="Wrap"/></StackPanel>
                      <TextBlock Text="O modelo atual não armazena outros atributos técnicos por produto." FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </TabItem>
                  <TabItem Header="Fornecedores" FontSize="{DynamicResource DecorFontSizeBase}">
                    <TextBlock Margin="8,12" Text="O cadastro atual não mantém fornecedores associados diretamente ao produto." Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                  </TabItem>
                  <TabItem Header="Classificação" FontSize="{DynamicResource DecorFontSizeBase}">
                    <StackPanel Spacing="8" Margin="8,12">
                      <TextBlock Text="Hierarquia de classificação" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="5,*" ColumnSpacing="8"><Border Grid.Column="0" Width="4" CornerRadius="2" Background="#2074B8"/><StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Classe" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedProductClassName}" TextWrapping="Wrap"/></StackPanel></Grid>
                        <Grid ColumnDefinitions="5,*" ColumnSpacing="8"><Border Grid.Column="0" Width="4" CornerRadius="2" Background="#63844F"/><StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Família" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedProductFamilyName}" TextWrapping="Wrap"/></StackPanel></Grid>
                        <Grid ColumnDefinitions="5,*" ColumnSpacing="8"><Border Grid.Column="0" Width="4" CornerRadius="2" Background="#A66A17"/><StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Grupo" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedProductGroupName}" TextWrapping="Wrap"/></StackPanel></Grid>
                        <Grid ColumnDefinitions="5,*" ColumnSpacing="8"><Border Grid.Column="0" Width="4" CornerRadius="2" Background="#755B91"/><StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="Subgrupo" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedProductSubgroupName}" TextWrapping="Wrap"/></StackPanel></Grid>
                      </StackPanel>
                    </StackPanel>
                  </TabItem>
                </TabControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Formulário de Edição (substitui DataGrid) -->
      <Border Grid.Row="2" BorderThickness="0" Padding="0" CornerRadius="4" IsVisible="{Binding IsEditing}">
        <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="ProductFormScrollViewer" controls:DecorScrollViewerBehavior.ResetToHomeWhenVisible="True"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,0,20,0">
            <TextBlock FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" Text="Informações do Produto" Margin="0,0,0,12"/>
            
            <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Código" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ProductCodeDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <ToggleSwitch TabIndex="2" IsChecked="{Binding IsActive}" OnContent="Ativo" OffContent="Inativo" MinWidth="115"/>
                </StackPanel>
            </Grid>
            </Border>
            
            <StackPanel Spacing="4">
              <TextBlock Text="EAN" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="3" Text="{Binding Barcode}" MaxLength="13" Width="180" HorizontalAlignment="Left" controls:DecorNumericInput.DigitsOnly="True"/>
              <TextBlock Text="{Binding BarcodeError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasBarcodeError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Produto" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="4" Text="{Binding ProductName}" controls:DecorRequiredField.IsRequired="True"/>
              <TextBlock Text="{Binding ProductNameError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasProductNameError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4" Width="240" HorizontalAlignment="Left">
              <TextBlock Text="Unidade de Medida" FontWeight="{DynamicResource DecorFontWeightBase}" TextWrapping="Wrap" MinHeight="20"/>
              <ComboBox TabIndex="5" ItemsSource="{Binding StockUnits}" SelectedItem="{Binding SelectedStockUnit}" Width="240" HorizontalAlignment="Left" controls:DecorRequiredField.IsRequired="True">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="dto:UnitOfMeasureDTO"><TextBlock Text="{Binding Code}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding StockUnitError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasStockUnitError}"/>
            </StackPanel>

            <StackPanel Spacing="4" HorizontalAlignment="Left">
              <TextBlock Text="Aquisição" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <ToggleSwitch TabIndex="6" Content="Comprar somente após pedido confirmado" IsChecked="{Binding IsMadeToOrder, Mode=TwoWay}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalAlignment="Stretch" MaxWidth="420">
              <StackPanel Spacing="4" MinWidth="0" HorizontalAlignment="Stretch">
                <TextBlock Text="Estoque Inicial" FontWeight="{DynamicResource DecorFontWeightBase}" TextWrapping="Wrap" MinHeight="20"/>
                <Border Classes="quantity-field" MinWidth="0" Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid ColumnDefinitions="*,36">
                    <NumericUpDown TabIndex="7" Value="{Binding StockQuantity}" Minimum="0" IsEnabled="False" BorderThickness="0" HorizontalContentAlignment="Right" ShowButtonSpinner="False" AllowSpin="False" controls:DecorNumericInput.Quantity="True"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedStockUnitCode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding StockQuantityError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasStockQuantityError}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4" MinWidth="0" HorizontalAlignment="Stretch">
                <TextBlock Text="Estoque Mínimo" FontWeight="{DynamicResource DecorFontWeightBase}" TextWrapping="Wrap" MinHeight="20"/>
                <Border Classes="quantity-field" MinWidth="0" Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid ColumnDefinitions="*,36">
                    <NumericUpDown TabIndex="6" Value="{Binding MinimumStock}" Minimum="0" BorderThickness="0" HorizontalContentAlignment="Right" ShowButtonSpinner="False" AllowSpin="False" controls:DecorNumericInput.Quantity="True"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedStockUnitCode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding MinimumStockError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasMinimumStockError}"/>
              </StackPanel>
            </Grid>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Ref. Fabricante" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="7" Text="{Binding ManufacturerRef}"/>
              <TextBlock Text="{Binding ManufacturerRefError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasManufacturerRefError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Ref. Auxiliar" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="8" Text="{Binding AuxiliarRef}"/>
              <TextBlock Text="{Binding AuxiliarRefError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasAuxiliarRefError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Dimensões" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="9" Text="{Binding Dimensions}"/>
              <TextBlock Text="{Binding DimensionsError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasDimensionsError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Marca" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <Grid HorizontalAlignment="Left">
                <!-- Invisible overlapped copy of every brand name: the grid takes the widest text so the ComboBox never resizes. -->
                <ItemsControl ItemsSource="{Binding Brands}" Opacity="0" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Panel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="dto:BrandDTO"><TextBlock Text="{Binding BrandName}" Margin="12,0,44,0"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox TabIndex="10" ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" HorizontalAlignment="Stretch" controls:DecorRequiredField.IsRequired="True">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="dto:BrandDTO"><TextBlock Text="{Binding BrandName}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <TextBlock Text="{Binding BrandError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasBrandError}"/>
            </StackPanel>
            
            <StackPanel Spacing="6" Margin="0,12,0,0">
              <TextBlock Text="Classificação Hierárquica" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <TextBlock Text="Escolha o subgrupo ao qual este produto pertence." FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
              <TextBox TabIndex="11" Text="{Binding EditorClassificationSearchText, Mode=TwoWay}" PlaceholderText="Pesquisar classificação"/>
              <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Height="250">
                <TreeView ItemsSource="{Binding FilteredEditorClassificationTreeNodes}" SelectedItem="{Binding SelectedEditorClassificationNode, Mode=TwoWay}" ItemTemplate="{StaticResource ClassificationTreeTemplate}" ItemContainerTheme="{StaticResource ClassificationTreeItemTheme}" controls:DecorRequiredField.IsRequired="True"/>
              </Border>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding SelectedClassificationPath}" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding IncludeEditorClassificationCommand}" IsEnabled="{Binding CanIncludeEditorClassification}" Classes="product-secondary-action" TabIndex="12">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{DynamicResource DecorAccentBrush}" Width="15" Height="15" Stretch="Uniform"/>
                    <TextBlock Text="Incluir descendente" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding SubgroupError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasSubgroupError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Observações" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="11" Text="{Binding Observations}" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ObservationsCounter}" HorizontalAlignment="Right" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
              <TextBlock Text="{Binding ObservationsError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasObservationsError}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button TabIndex="12" Command="{Binding SaveCommand}" IsVisible="{Binding CanSave}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{DynamicResource DecorAccentBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button TabIndex="13" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{DynamicResource DecorDangerBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        </Grid>
      </Border>

  </Grid>
</UserControl>
