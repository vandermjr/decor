<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Decor.AvaloniaUI.Controls"
    xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
    xmlns:dto="using:Decor.Core.DTOs"
    xmlns:icons="using:Decor.AvaloniaUI.Icons"
    x:Class="Decor.AvaloniaUI.Views.ProductsView"
    x:DataType="vm:ProductsViewModel">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ErrorBrush">#FFB3261E</SolidColorBrush>
    <SolidColorBrush x:Key="CatalogActionBackgroundBrush">#F6AB58</SolidColorBrush>
    <SolidColorBrush x:Key="CatalogActionForegroundBrush">#332611</SolidColorBrush>
    <SolidColorBrush x:Key="CatalogActionBorderBrush">#D6A02E</SolidColorBrush>
    <SolidColorBrush x:Key="CatalogActionHoverBrush">#E9AE31</SolidColorBrush>
    <SolidColorBrush x:Key="CatalogActionPressedBrush">#D9991D</SolidColorBrush>
    <SolidColorBrush x:Key="CatalogActionDisabledBackgroundBrush">#D8CCB4</SolidColorBrush>
    <SolidColorBrush x:Key="CatalogActionDisabledForegroundBrush">#625842</SolidColorBrush>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="PathIcon.catalog-total-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Common.Database}"/></Style>
    <Style Selector="PathIcon.catalog-active-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Common.Status}"/></Style>
    <Style Selector="PathIcon.catalog-empty-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Actions.Remove}"/></Style>
    <Style Selector="PathIcon.catalog-low-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Actions.Filter}"/></Style>
    <Style Selector="PathIcon.product-placeholder-icon"><Setter Property="icons:DecorIcon.Id" Value="{x:Static icons:DecorIconId+Forms.Products}"/></Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog DataGridColumnHeader">
      <Setter Property="Height" Value="38"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog DataGridRow">
      <Setter Property="MinHeight" Value="44"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog .grid-column-ProductID">
      <Setter x:SetterTargetType="TextBlock" Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog .grid-column-StockStatus">
      <Setter x:SetterTargetType="TextBlock" Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog .grid-column-Description">
      <Setter x:SetterTargetType="TextBlock" Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="controls|DecorDataGridControl.stock-catalog .grid-column-AvailableStockQuantity">
      <Setter x:SetterTargetType="TextBlock" Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.quantity-field">
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
    </Style>
    <Style Selector="Border.quantity-field:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource DecorFieldFocusBrush}"/>
    </Style>
    <Style Selector="Button.product-secondary-action">
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action">
      <Setter Property="Height" Value="38"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Background" Value="{DynamicResource CatalogActionBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource CatalogActionHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:pressed">
      <Setter Property="Background" Value="{DynamicResource CatalogActionPressedBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionBorderBrush}"/>
    </Style>
    <Style Selector="Button.catalog-accent-action:disabled">
      <Setter Property="Background" Value="{DynamicResource CatalogActionDisabledBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource CatalogActionDisabledForegroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CatalogActionDisabledBackgroundBrush}"/>
    </Style>
    <Style Selector="Border.column-menu">
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
    </Style>
    <Style Selector="ProgressBar.product-stock-level">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Foreground" Value="{DynamicResource DecorStockLevelBrush}"/>
      <Setter Property="Background" Value="{DynamicResource DecorScrollTrackBrush}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="18">
    <StackPanel Grid.Row="0" Spacing="4" IsVisible="{Binding !IsEditing}">
      <TextBlock Text="Catálogo de produtos" FontSize="{DynamicResource DecorFontSizeDisplay}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <TextBlock Text="Catálogo, preços e disponibilidade do estoque." FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid x:Name="CatalogSummaryLayout" Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="10" IsVisible="{Binding HasCatalogSummary}">
      <Border x:Name="TotalProductsCard" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Classes="catalog-total-icon" Width="19" Height="19" Foreground="{DynamicResource DecorAccentBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Produtos cadastrados" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
            <TextBlock Text="{Binding TotalProductsDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="ActiveProductsCard" Grid.Column="1" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Classes="catalog-active-icon" Width="19" Height="19" Foreground="{DynamicResource DecorAddIndicatorBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Ativos" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
            <TextBlock Text="{Binding ActiveProductsDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="OutOfStockProductsCard" Grid.Column="2" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Classes="catalog-empty-icon" Width="19" Height="19" Foreground="{DynamicResource DecorDangerBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Sem estoque" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
            <TextBlock Text="{Binding OutOfStockProductsDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="LowStockProductsCard" Grid.Column="3" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <PathIcon Classes="catalog-low-icon" Width="19" Height="19" Foreground="{DynamicResource DecorEditIndicatorBrush}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="Estoque baixo" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
            <TextBlock Text="{Binding LowStockProductsDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Grid x:Name="CatalogLayout" Grid.Row="2" RowDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="12" IsVisible="{Binding !IsEditing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.75*" MinWidth="0"/>
        <ColumnDefinition Width="*" MinWidth="350" MaxWidth="420"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Row="0" Grid.Column="0" MinHeight="104" VerticalAlignment="Top" Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
        <StackPanel Spacing="8">
        <controls:DecorSearchField x:Name="SearchTextBox" HorizontalAlignment="Stretch" TabIndex="0" Text="{Binding SearchText, Mode=TwoWay}"
                                   PlaceholderText="Pesquisar por código, descrição, marca ou referência" SearchHelp="{x:Static controls:DecorSearchField.ProductSearchHelp}"
                                   SearchCommand="{Binding SearchCommand}" ClearCommand="{Binding ClearSearchCommand}"/>
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Classes="catalog-accent-action" TabIndex="1" Command="{Binding NewCommand}" IsVisible="{Binding CanNew}" Margin="2">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{DynamicResource CatalogActionForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
              <TextBlock Text="Novo produto" Foreground="{DynamicResource CatalogActionForegroundBrush}" FontWeight="Normal" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="product-secondary-action" TabIndex="2" Click="ExportProductsClicked" IsEnabled="{Binding CanExport}" Margin="2" ToolTip.Tip="Exportar os produtos encontrados">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Report}" Fill="{DynamicResource DecorTextMutedBrush}" Width="16" Height="16" Stretch="Uniform"/>
              <TextBlock Text="Exportar" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="product-secondary-action" TabIndex="3" Click="ConfigureColumnsClicked" Margin="2" ToolTip.Tip="Escolher colunas visíveis">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Application.Settings}" Fill="{DynamicResource DecorTextMutedBrush}" Width="16" Height="16" Stretch="Uniform"/>
              <TextBlock Text="Configurar colunas" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </WrapPanel>
        </StackPanel>
    </Border>

    <!-- DataGrid ou Formulário (alternância) -->
        <Border x:Name="ProductsGridFrame" Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource DecorSurfaceRaisedBrush}">
          <controls:DecorDataGridControl x:Name="ProductsGrid" Classes="stock-catalog" PaginationSource="{Binding}" DefaultSortMemberPath="ProductID" ItemsSource="{Binding Products}"
                SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        </Border>
        <Border x:Name="ProductDetailsPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" MinWidth="350" MaxWidth="420" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource DecorSurfaceRaisedBrush}" Padding="14">
          <Grid>
            <StackPanel IsVisible="{Binding !HasSelectedProduct}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="240">
              <PathIcon Classes="product-placeholder-icon" Width="38" Height="38" Foreground="{DynamicResource DecorTextMutedBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Selecione um produto" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock Text="Os dados do produto selecionado aparecem aqui." Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <ScrollViewer IsVisible="{Binding HasSelectedProduct}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                  <Border Width="96" Height="96" CornerRadius="6" Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1">
                    <PathIcon Classes="product-placeholder-icon" Width="34" Height="34" Foreground="{DynamicResource DecorTextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="{Binding SelectedProduct.Description}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" TextWrapping="Wrap" MaxLines="3"/>
                    <TextBlock Text="{Binding SelectedProductCodeDisplay, StringFormat='Código {0}'}" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                    <TextBlock Text="{Binding SelectedProductCategoryDisplay}" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedProduct.BrandName}" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                    <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Background="{DynamicResource DecorSurfaceBrush}" IsVisible="{Binding IsSelectedProductActive}">
                      <TextBlock Text="{Binding SelectedProductStateDisplay}" Foreground="{DynamicResource DecorAddIndicatorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                    </Border>
                    <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Background="{DynamicResource DecorSurfaceBrush}" IsVisible="{Binding IsSelectedProductInactive}">
                      <TextBlock Text="{Binding SelectedProductStateDisplay}" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                    </Border>
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Preço de venda" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                    <TextBlock Text="{Binding SelectedSalePriceDisplay}" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3" IsVisible="{Binding HasSelectedCostPrice}" VerticalAlignment="Center">
                    <TextBlock Text="Custo" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                    <TextBlock Text="{Binding SelectedCostPriceDisplay}" FontSize="{DynamicResource DecorFontSizeBase}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <Border Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Disponível" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedAvailableStockDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                      </StackPanel>
                      <Border Grid.Column="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource DecorSurfaceRaisedBrush}" IsVisible="{Binding IsSelectedStockPositive}">
                        <TextBlock Text="{Binding SelectedStockStatusDisplay}" Foreground="{DynamicResource DecorAddIndicatorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                      </Border>
                      <Border Grid.Column="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource DecorSurfaceRaisedBrush}" IsVisible="{Binding IsSelectedStockWarning}">
                        <TextBlock Text="{Binding SelectedStockStatusDisplay}" Foreground="{DynamicResource DecorEditIndicatorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                      </Border>
                      <Border Grid.Column="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource DecorSurfaceRaisedBrush}" IsVisible="{Binding IsSelectedStockNegative}">
                        <TextBlock Text="{Binding SelectedStockStatusDisplay}" Foreground="{DynamicResource DecorDangerBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                      </Border>
                      <Border Grid.Column="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center" Background="{DynamicResource DecorSurfaceRaisedBrush}" IsVisible="{Binding IsSelectedStockMadeToOrder}">
                        <TextBlock Text="{Binding SelectedStockStatusDisplay}" Foreground="{DynamicResource DecorAccentBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                      </Border>
                    </Grid>
                    <ProgressBar Classes="product-stock-level" Minimum="0" Maximum="100" Value="{Binding SelectedStockLevelValue}" IsVisible="{Binding HasSelectedStockMinimum}"/>
                    <TextBlock Text="{Binding SelectedStockLevelDescription}" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                  </StackPanel>
                </Border>
                <Button Classes="catalog-accent-action" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Edit}" Fill="{DynamicResource CatalogActionForegroundBrush}" Width="16" Height="16" Stretch="Uniform"/>
                    <TextBlock Text="Editar produto" Foreground="{DynamicResource CatalogActionForegroundBrush}" FontWeight="Normal" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <TabControl MinHeight="180">
                  <TabItem Header="Resumo" FontSize="{DynamicResource DecorFontSizeCaption}">
                    <StackPanel Spacing="10" Margin="8,12">
                      <StackPanel Spacing="3">
                        <TextBlock Text="Código de barras" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedBarcodeDisplay}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Aquisição" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedAcquisitionModeDisplay}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Observações" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                        <TextBlock Text="{Binding SelectedObservationsDisplay}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </TabItem>
                  <TabItem Header="Especificações" FontSize="{DynamicResource DecorFontSizeCaption}">
                    <StackPanel Spacing="10" Margin="8,12">
                      <StackPanel Spacing="3"><TextBlock Text="Dimensões" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedDimensionsDisplay}" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="Unidade de medida" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedStockUnitDisplay}" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="Referência do fabricante" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedManufacturerReferenceDisplay}" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Spacing="3"><TextBlock Text="Referência auxiliar" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/><TextBlock Text="{Binding SelectedAuxiliaryReferenceDisplay}" TextWrapping="Wrap"/></StackPanel>
                      <TextBlock Text="O modelo atual não armazena outros atributos técnicos por produto." FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </TabItem>
                  <TabItem Header="Fornecedores" FontSize="{DynamicResource DecorFontSizeCaption}">
                    <TextBlock Margin="8,12" Text="O cadastro atual não mantém fornecedores associados diretamente ao produto." Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                  </TabItem>
                </TabControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Formulário de Edição (substitui DataGrid) -->
      <Border Grid.Row="2" BorderThickness="0" Padding="0" CornerRadius="4" IsVisible="{Binding IsEditing}">
        <Grid RowDefinitions="*,Auto">
        <ScrollViewer x:Name="ProductFormScrollViewer" controls:DecorScrollViewerBehavior.ResetToHomeWhenVisible="True"
                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,0,20,0">
            <TextBlock FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" Text="Informações do Produto" Margin="0,0,0,12"/>
            
            <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Código" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ProductCodeDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <ToggleSwitch TabIndex="2" IsChecked="{Binding IsActive}" OnContent="Ativo" OffContent="Inativo" MinWidth="115"/>
                </StackPanel>
            </Grid>
            </Border>
            
            <StackPanel Spacing="4">
              <TextBlock Text="EAN" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="3" Text="{Binding Barcode}" MaxLength="13" Width="180" HorizontalAlignment="Left" controls:DecorNumericInput.DigitsOnly="True"/>
              <TextBlock Text="{Binding BarcodeError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasBarcodeError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Descrição" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="4" Text="{Binding Description}" controls:DecorRequiredField.IsRequired="True"/>
              <TextBlock Text="{Binding DescriptionError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasDescriptionError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4" Width="240" HorizontalAlignment="Left">
              <TextBlock Text="Unidade de Medida" FontWeight="{DynamicResource DecorFontWeightBase}" TextWrapping="Wrap" MinHeight="20"/>
              <ComboBox TabIndex="5" ItemsSource="{Binding StockUnits}" SelectedItem="{Binding SelectedStockUnit}" Width="240" HorizontalAlignment="Left" controls:DecorRequiredField.IsRequired="True">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="dto:UnitOfMeasureDTO"><TextBlock Text="{Binding Code}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding StockUnitError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasStockUnitError}"/>
            </StackPanel>

            <StackPanel Spacing="4" HorizontalAlignment="Left">
              <TextBlock Text="Aquisição" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <ToggleSwitch TabIndex="6" Content="Comprar somente após pedido confirmado" IsChecked="{Binding IsMadeToOrder, Mode=TwoWay}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalAlignment="Stretch" MaxWidth="420">
              <StackPanel Spacing="4" MinWidth="0" HorizontalAlignment="Stretch">
                <TextBlock Text="Estoque Inicial" FontWeight="{DynamicResource DecorFontWeightBase}" TextWrapping="Wrap" MinHeight="20"/>
                <Border Classes="quantity-field" MinWidth="0" Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid ColumnDefinitions="*,36">
                    <NumericUpDown TabIndex="7" Value="{Binding StockQuantity}" Minimum="0" IsEnabled="False" BorderThickness="0" HorizontalContentAlignment="Right" ShowButtonSpinner="False" AllowSpin="False" controls:DecorNumericInput.Quantity="True"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedStockUnitCode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding StockQuantityError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasStockQuantityError}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4" MinWidth="0" HorizontalAlignment="Stretch">
                <TextBlock Text="Estoque Mínimo" FontWeight="{DynamicResource DecorFontWeightBase}" TextWrapping="Wrap" MinHeight="20"/>
                <Border Classes="quantity-field" MinWidth="0" Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid ColumnDefinitions="*,36">
                    <NumericUpDown TabIndex="6" Value="{Binding MinimumStock}" Minimum="0" BorderThickness="0" HorizontalContentAlignment="Right" ShowButtonSpinner="False" AllowSpin="False" controls:DecorNumericInput.Quantity="True"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedStockUnitCode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock Text="{Binding MinimumStockError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasMinimumStockError}"/>
              </StackPanel>
            </Grid>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Ref. Fabricante" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="7" Text="{Binding ManufacturerRef}"/>
              <TextBlock Text="{Binding ManufacturerRefError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasManufacturerRefError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Ref. Auxiliar" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="8" Text="{Binding AuxiliarRef}"/>
              <TextBlock Text="{Binding AuxiliarRefError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasAuxiliarRefError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Dimensões" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="9" Text="{Binding Dimensions}"/>
              <TextBlock Text="{Binding DimensionsError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasDimensionsError}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
              <TextBlock Text="Marca" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <Grid HorizontalAlignment="Left">
                <!-- Invisible overlapped copy of every brand name: the grid takes the widest text so the ComboBox never resizes. -->
                <ItemsControl ItemsSource="{Binding Brands}" Opacity="0" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><Panel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="dto:BrandDTO"><TextBlock Text="{Binding BrandName}" Margin="12,0,44,0"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ComboBox TabIndex="10" ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrand}" HorizontalAlignment="Stretch" controls:DecorRequiredField.IsRequired="True">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="dto:BrandDTO"><TextBlock Text="{Binding BrandName}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <TextBlock Text="{Binding BrandError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasBrandError}"/>
            </StackPanel>
            
            <TextBlock Text="Classificação Hierárquica" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,12,0,8"/>
            <Grid Height="160" ClipToBounds="True" ColumnDefinitions="1*,1*,1*,1*" ColumnSpacing="8">
              <Border BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <TextBlock Text="Classes" FontWeight="{DynamicResource DecorFontWeightBase}"/>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="dto:ClassDTO">
                        <TextBlock Text="{Binding ClassName}" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <TextBlock Text="Famílias" FontWeight="{DynamicResource DecorFontWeightBase}"/>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="dto:FamilyDTO">
                        <TextBlock Text="{Binding FamilyName}" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <TextBlock Text="Grupos" FontWeight="{DynamicResource DecorFontWeightBase}"/>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="dto:GroupDTO">
                        <TextBlock Text="{Binding GroupName}" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="3" BorderBrush="Gray" BorderThickness="1" Padding="8" CornerRadius="4" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                  <TextBlock Text="Subgrupos" FontWeight="{DynamicResource DecorFontWeightBase}"/>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Subgroups}" SelectedItem="{Binding SelectedSubgroup}" controls:DecorRequiredField.IsRequired="True">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="dto:SubgroupDTO">
                        <TextBlock Text="{Binding SubgroupName}" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </Grid>
            
            <StackPanel Spacing="4" Margin="0,8,0,0">
              <TextBlock Text="Observações" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox TabIndex="11" Text="{Binding Observations}" AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ObservationsCounter}" HorizontalAlignment="Right" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
              <TextBlock Text="{Binding ObservationsError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasObservationsError}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button TabIndex="12" Command="{Binding SaveCommand}" IsVisible="{Binding CanSave}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{DynamicResource DecorAccentBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button TabIndex="13" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{DynamicResource DecorDangerBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        </Grid>
      </Border>

  </Grid>
</UserControl>
