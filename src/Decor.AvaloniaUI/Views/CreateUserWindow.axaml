<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
        x:Class="Decor.AvaloniaUI.Views.CreateUserWindow"
        x:DataType="vm:CreateUserViewModel"
        Title="Decor — Novo usuário"
        Width="520"
        Height="620"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
    <StackPanel Spacing="4">
      <TextBlock Text="Novo usuário" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <TextBlock Text="Crie o usuário e selecione as roles iniciais." Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="Nome de usuário"/>
      <TextBox TabIndex="0" Text="{Binding Username}" MaxLength="50" IsEnabled="{Binding CanEditFields}"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="6">
      <TextBlock Text="Nome de exibição"/>
      <TextBox TabIndex="1" Text="{Binding DisplayName}" MaxLength="100" IsEnabled="{Binding CanEditFields}"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Spacing="6">
      <TextBlock Text="Funções" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <TextBlock Text="A autoridade do serviço validará a hierarquia." Foreground="{DynamicResource DecorTextMutedBrush}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="4">
      <ItemsControl ItemsSource="{Binding Roles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CreateUserRoleOption">
            <CheckBox TabIndex="2" IsChecked="{Binding IsSelected}">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Role.RoleName}"/>
                <TextBlock Text="{Binding Role.Description}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Role.HierarchyLevel, StringFormat='Nível: {0}'}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="5" Padding="10" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorDangerBrush}" BorderThickness="1" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
    </Border>
    <Border Grid.Row="5" Padding="10" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorAccentBrush}" BorderThickness="1" IsVisible="{Binding HasTemporaryPassword}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap"/>
        <TextBlock Text="Senha temporária" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
        <TextBlock Text="{Binding TemporaryPassword}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <ProgressBar Width="100" Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
      <Button TabIndex="3" Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding !IsCompleted}"/>
      <Button TabIndex="4" Content="Criar" Command="{Binding CreateCommand}" IsVisible="{Binding !IsCompleted}"/>
      <Button TabIndex="3" Content="Fechar" Command="{Binding FinishCommand}" IsVisible="{Binding IsCompleted}"/>
    </StackPanel>
  </Grid>
</Window>