<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
    xmlns:dto="using:Decor.Core.DTOs"
    x:Class="Decor.AvaloniaUI.Views.ClassificationsView"
    x:DataType="vm:ClassificationsViewModel">
  <Grid RowDefinitions="Auto,*" Margin="16" ColumnDefinitions="*">
    <TextBlock Text="Hierarquia de classificação" FontSize="{DynamicResource DecorFontSizeTitle}" Margin="0,0,0,12"/>

    <Grid Grid.Row="1" ColumnDefinitions="1*,1*,1*,1*" ColumnSpacing="12">
      <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="4">
        <StackPanel>
          <TextBlock Text="Classes" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:ClassDTO">
                <TextBlock Text="{Binding ClassName}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="4">
        <StackPanel>
          <TextBlock Text="Famílias" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:FamilyDTO">
                <TextBlock Text="{Binding FamilyName}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="4">
        <StackPanel>
          <TextBlock Text="Grupos" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:GroupDTO">
                <TextBlock Text="{Binding GroupName}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Grid.Column="3" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="4">
        <StackPanel>
          <TextBlock Text="Subgrupos" Margin="0,0,0,8"/>
          <ListBox ItemsSource="{Binding Subgroups}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dto:SubgroupDTO">
                <TextBlock Text="{Binding SubgroupName}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</UserControl>
