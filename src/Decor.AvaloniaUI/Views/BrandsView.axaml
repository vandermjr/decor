<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             x:Class="Decor.AvaloniaUI.Views.BrandsView"
             x:DataType="vm:BrandsViewModel">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ErrorBrush">#FFB3261E</SolidColorBrush>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !IsEditing}">
        <TextBox x:Name="SearchTextBox" TabIndex="0" Text="{Binding SearchText}" PlaceholderText="Pesquisar por nome" KeyDown="SearchTextBox_KeyDown"/>
        <Button Grid.Column="1" TabIndex="1" Content="Pesquisar" Command="{Binding SearchCommand}"/>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button TabIndex="2" Content="Nova" Command="{Binding NewCommand}" IsVisible="{Binding CanNew}"/>
        <Button TabIndex="3" Content="Editar" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}"/>
        <Button TabIndex="4" Content="Excluir" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" Background="{DynamicResource DecorDangerBrush}" Foreground="White"/>
        <Button TabIndex="0" Content="Salvar" Command="{Binding SaveCommand}" IsVisible="{Binding CanSave}" Background="#4CAF50" Foreground="White"/>
        <Button TabIndex="1" Content="Cancelar" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Background="#F44336" Foreground="White"/>
      </StackPanel>
    </Grid>

    <Panel Grid.Row="1">
      <controls:DecorDataGridControl x:Name="BrandsGrid"
                                      ItemsSource="{Binding Brands}"
                                      SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      IsVisible="{Binding !IsEditing}"/>

      <Border BorderThickness="0" Padding="0" CornerRadius="4" IsVisible="{Binding IsEditing}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,0,20,0">
            <TextBlock FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" Text="Informações da Marca" Margin="0,0,0,12"/>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Background="{DynamicResource DecorSurfaceRaisedBrush}"
                      BorderBrush="{DynamicResource DecorBorderBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="ID" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding BrandId}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Text="Nome da marca" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <TextBox TabIndex="2" Text="{Binding BrandName}"/>
              <TextBlock Text="{Binding BrandNameError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasBrandNameError}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Panel>

    <!-- Delete Confirmation Dialog -->
    <Panel Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource DecorOverlayBrush}" IsVisible="{Binding ShowDeleteConfirmation}" ZIndex="1000">
      <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Background="{DynamicResource DecorSurfaceRaisedBrush}" Padding="24" CornerRadius="8">
        <StackPanel Spacing="16">
          <TextBlock Text="Confirmação de Exclusão" FontSize="{DynamicResource DecorFontSizeSection}"/>
          <TextBlock Text="{Binding DeleteConfirmationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DecorTextBrush}"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0" TabIndex="0" Content="Sim, excluir" Background="{DynamicResource DecorDangerBrush}" Foreground="White" Command="{Binding ConfirmDeleteCommand}"/>
            <Button Grid.Column="1" TabIndex="1" Content="Não, cancelar" Command="{Binding CancelDeleteCommand}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
