<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.BrandsView"
             x:DataType="vm:BrandsViewModel">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ErrorBrush">#FFB3261E</SolidColorBrush>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
      <Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" IsVisible="{Binding !IsEditing}">
      <Grid ColumnDefinitions="*,36,36">
        <TextBox x:Name="SearchTextBox" TabIndex="0" Text="{Binding SearchText}" PlaceholderText="Pesquisar por nome" KeyDown="SearchTextBox_KeyDown" BorderThickness="0"/>
        <Button Grid.Column="1" TabIndex="1" Classes="search-button" Command="{Binding SearchCommand}" Margin="0" Padding="0" Width="36" MinWidth="36" Height="NaN" MinHeight="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="0" ToolTip.Tip="Pesquisar">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
        </Button>
        <Button Grid.Column="2" Classes="clear-search-button" Command="{Binding ClearSearchCommand}" Margin="0" Padding="0" Width="36" MinWidth="36" Height="NaN" MinHeight="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="0" ToolTip.Tip="Limpar pesquisa">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Clear}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
        </Button>
      </Grid>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button TabIndex="2" Command="{Binding NewCommand}" IsVisible="{Binding CanNew}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="Novo registro" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button TabIndex="3" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Edit}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="Editar" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button TabIndex="4" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" Background="{DynamicResource DecorDangerBrush}" Foreground="White">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Delete}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="Excluir" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Panel Grid.Row="1">
      <controls:DecorDataGridControl x:Name="BrandsGrid" PaginationSource="{Binding}"
                                      DefaultSortMemberPath="BrandName"
                                      ItemsSource="{Binding Brands}"
                                      SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      IsVisible="{Binding !IsEditing}"/>

      <Border BorderThickness="0" Padding="0" CornerRadius="4" IsVisible="{Binding IsEditing}">
        <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,0,20,0">
            <TextBlock FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" Text="Informações da Marca" Margin="0,0,0,12"/>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Background="{DynamicResource DecorSurfaceRaisedBrush}"
                      BorderBrush="{DynamicResource DecorBorderBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Código" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding BrandCodeDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Text="Nome da marca" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <TextBox TabIndex="2" Text="{Binding BrandName}"/>
              <TextBlock Text="{Binding BrandNameError}" Foreground="{StaticResource ErrorBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" IsVisible="{Binding HasBrandNameError}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button TabIndex="3" Command="{Binding SaveCommand}" IsVisible="{Binding CanSave}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button TabIndex="4" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
        </Grid>
      </Border>
    </Panel>

    <!-- Delete Confirmation Dialog -->
    <Panel Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource DecorOverlayBrush}" IsVisible="{Binding ShowDeleteConfirmation}" ZIndex="1000">
      <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Background="{DynamicResource DecorSurfaceRaisedBrush}" Padding="24" CornerRadius="8">
        <StackPanel Spacing="16">
          <TextBlock Text="Confirmação de Exclusão" FontSize="{DynamicResource DecorFontSizeSection}"/>
          <TextBlock Text="{Binding DeleteConfirmationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DecorTextBrush}"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0" TabIndex="0" Content="Sim, excluir" Background="{DynamicResource DecorDangerBrush}" Foreground="White" Command="{Binding ConfirmDeleteCommand}"/>
            <Button Grid.Column="1" TabIndex="1" Content="Não, cancelar" Command="{Binding CancelDeleteCommand}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
