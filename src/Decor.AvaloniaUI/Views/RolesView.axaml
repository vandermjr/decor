<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:dtos="using:Decor.Core.DTOs"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.RolesView"
             x:DataType="vm:RolesViewModel">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Permissões dos grupos" FontSize="{DynamicResource DecorFontSizeTitle}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
        <ProgressBar Width="120" Height="6" IsIndeterminate="True"/>
        <TextBlock Text="Carregando..." Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="1.2*,1.2*,1.6*" ColumnSpacing="12">
      <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Grupos de Permissões" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,8"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}" IsEnabled="{Binding CanSelectRole}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dtos:AdministrativeRoleDTO">
                  <TextBlock Text="{Binding RoleName}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Módulos" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,8"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}" IsEnabled="{Binding CanEditPermissions}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Contextos" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,8"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEditPermissions}">
            <ItemsControl ItemsSource="{Binding Forms}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RoleFunctionalContext">
                  <CheckBox Content="{Binding ContextName}" IsChecked="{Binding IsAssociated, Mode=TwoWay}" Margin="0,4"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Command="{Binding SaveCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
          <TextBlock Text="Salvar" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Command="{Binding RestoreCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Backup}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
          <TextBlock Text="Restaurar padrões" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsSaving}">
        <ProgressBar Width="120" Height="6" IsIndeterminate="True"/>
        <TextBlock Text="Salvando..." Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>
    </Border>

    <Border Grid.Row="2" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
