<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:dtos="using:Decor.Core.DTOs"
             x:Class="Decor.AvaloniaUI.Views.RolesView"
             x:DataType="vm:RolesViewModel">
  <Grid Margin="16" ColumnDefinitions="280,12,*">
    <Border BorderBrush="{DynamicResource DecorBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource DecorSurfaceRaisedBrush}"
            Padding="12">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Grupos de Permissões"
                   FontSize="{DynamicResource DecorFontSizeSection}"
                   FontWeight="{DynamicResource DecorFontWeightHeading}" />
        <Border Grid.Row="1"
                Margin="0,12,0,0"
                BorderBrush="{DynamicResource DecorBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource DecorControlBrush}">
          <Grid>
            <TextBlock Text="Carregando grupos..."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DecorTextMutedBrush}"
                       IsVisible="{Binding IsLoading}" />
            <TextBlock Text="Nenhum grupo encontrado."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource DecorTextMutedBrush}"
                       IsVisible="{Binding HasNoRoles}" />
            <ListBox ItemsSource="{Binding Roles}"
                     SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                     IsVisible="{Binding !IsLoading}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="10,8" />
                  <Setter Property="MinHeight" Value="48" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dtos:AdministrativeRoleDTO">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding RoleName}" FontWeight="{DynamicResource DecorFontWeightHeading}" />
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <Border BorderBrush="{DynamicResource DecorBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource DecorSurfaceRaisedBrush}"
                Padding="16"
                IsVisible="{Binding HasSelectedRole}">
          <StackPanel Spacing="8">
            <TextBlock Text="Detalhes do grupo"
                       FontSize="{DynamicResource DecorFontSizeSection}"
                       FontWeight="{DynamicResource DecorFontWeightHeading}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
              <TextBlock Text="Nome:" FontWeight="{DynamicResource DecorFontWeightHeading}" />
              <TextBlock Grid.Column="1" Text="{Binding SelectedRole.RoleName}" />
              <TextBlock Grid.Row="1" Text="Descrição:" FontWeight="{DynamicResource DecorFontWeightHeading}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRole.Description}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="Nível hierárquico:" FontWeight="{DynamicResource DecorFontWeightHeading}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRole.HierarchyLevel}" />
              <TextBlock Grid.Row="3" Text="Grupo protegido:" FontWeight="{DynamicResource DecorFontWeightHeading}" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRole.IsSystemProtected, StringFormat='{}{0:Sim;Não}'}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource DecorBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource DecorSurfaceRaisedBrush}"
                Padding="16"
                IsVisible="{Binding HasSelectedRole}">
          <StackPanel Spacing="8">
            <TextBlock Text="Permissions"
                       FontSize="{DynamicResource DecorFontSizeSection}"
                       FontWeight="{DynamicResource DecorFontWeightHeading}" />
            <TextBlock Text="Carregando permissions..."
                       Foreground="{DynamicResource DecorTextMutedBrush}"
                       IsVisible="{Binding IsPermissionsLoading}" />
            <TextBlock Text="Nenhuma permission cadastrada."
                       Foreground="{DynamicResource DecorTextMutedBrush}"
                       IsVisible="{Binding HasNoPermissions}" />
            <ItemsControl ItemsSource="{Binding Permissions}" IsVisible="{Binding HasPermissions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RolePermissionItemViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3">
                    <CheckBox IsChecked="{Binding IsGranted}" IsEnabled="False" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding Permission.PermissionCode}" />
                      <TextBlock Text="{Binding Permission.Description}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="Selecione um grupo para consultar suas permissions."
                   Foreground="{DynamicResource DecorTextMutedBrush}"
                   IsVisible="{Binding !HasSelectedRole}" />
        <Border Padding="10"
                Background="{DynamicResource DecorSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource DecorDangerBrush}"
                BorderThickness="1"
                IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="{DynamicResource DecorDangerBrush}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
