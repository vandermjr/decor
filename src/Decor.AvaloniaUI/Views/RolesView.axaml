<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:dtos="using:Decor.Core.DTOs"
             x:Class="Decor.AvaloniaUI.Views.RolesView"
             x:DataType="vm:RolesViewModel">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
    <TextBlock Text="Grupos e permissões" FontSize="{DynamicResource DecorFontSizeTitle}"/>

    <Grid Grid.Row="1" ColumnDefinitions="1.2*,1.2*,1.2*,1.2*" ColumnSpacing="12">
      <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Grupos" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,8"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dtos:AdministrativeRoleDTO">
                <TextBlock Text="{Binding RoleName}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Módulos" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,8"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="Ações" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,8"/>
          <ListBox Grid.Row="1" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="3" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Text="Permissões" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,8"/>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding Permissions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RolePermissionToggle">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4">
                  <CheckBox IsChecked="{Binding IsGranted}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Permission.PermissionCode}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
      <Button Content="Salvar" Command="{Binding SaveCommand}"/>
    </StackPanel>

    <Border Grid.Row="3" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="12" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
</UserControl>
