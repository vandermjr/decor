<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.ServicesView"
             x:DataType="vm:ServicesViewModel">
  <Grid RowDefinitions="Auto,*" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12" IsVisible="{Binding !IsEditing}">
      <controls:DecorSearchField x:Name="SearchTextBox" TabIndex="0" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Pesquisar por código ou descrição"
                                SearchCommand="{Binding SearchCommand}" ClearCommand="{Binding ClearSearchCommand}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding NewCommand}" IsVisible="{Binding CanNew}" Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{DynamicResource DecorAddIndicatorBrush}" Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Novo registro" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Edit}" Fill="{DynamicResource DecorEditIndicatorBrush}" Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Editar" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"   Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Delete}" Fill="{DynamicResource DecorDangerBrush}" Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Excluir" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Panel Grid.Row="1">
      <controls:DecorDataGridControl x:Name="ServicesGrid" PaginationSource="{Binding}" DefaultSortMemberPath="ServiceID"
                                    ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="{Binding !IsEditing}"/>
      <Grid RowDefinitions="*,Auto" IsVisible="{Binding IsEditing}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="12" Margin="0,0,20,0" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="Informações do Serviço" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Código" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ServiceCodeDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
                </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">

                <ToggleSwitch IsChecked="{Binding IsActive}" OnContent="Ativo" OffContent="Inativo"/>
              </StackPanel>
            </Grid>
            </Border>
            <StackPanel Spacing="4">
              <TextBlock Text="Descrição" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox x:Name="DescriptionTextBox" Text="{Binding Description}" MaxLength="255" controls:DecorRequiredField.IsRequired="True"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Preço de custo" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <NumericUpDown Value="{Binding CostPrice}" Minimum="0" Maximum="99999999.99" Increment="0.01" FormatString="N2"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Preço de venda" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <NumericUpDown Value="{Binding SalePrice}" Minimum="0" Maximum="99999999.99" Increment="0.01" FormatString="N2"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Comissão do funcionário" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <NumericUpDown Value="{Binding EmployeeCommissionValue}" Minimum="0" Maximum="99999999.99" Increment="0.01" FormatString="N2"/>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="Observações" FontWeight="{DynamicResource DecorFontWeightBase}"/>
              <TextBox Text="{Binding Observations, UpdateSourceTrigger=PropertyChanged}" MaxLength="65535" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
              <TextBlock Text="{Binding ObservationsCounter}" HorizontalAlignment="Right" Foreground="{DynamicResource DecorTextMutedBrush}"/>
            </StackPanel>
            <TextBlock Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding SaveCommand}" Classes="decor-action">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{DynamicResource DecorAccentBrush}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" Classes="decor-action">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{DynamicResource DecorDangerBrush}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Panel>
    <Panel Grid.RowSpan="2" Background="{DynamicResource DecorOverlayBrush}" IsVisible="{Binding ShowDeleteConfirmation}" ZIndex="1000">
      <Border VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400" Margin="16" Background="{DynamicResource DecorSurfaceRaisedBrush}" Padding="24" CornerRadius="8">
        <StackPanel Spacing="16">
          <TextBlock Text="Confirmação de Exclusão" FontSize="{DynamicResource DecorFontSizeSection}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding DeleteConfirmationMessage}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Content="Sim, excluir"   Command="{Binding ConfirmDeleteCommand}" Classes="decor-action"/>
            <Button Content="Cancelar" Command="{Binding CancelDeleteCommand}" Classes="decor-action"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>