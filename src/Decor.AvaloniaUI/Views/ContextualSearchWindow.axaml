<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Decor.AvaloniaUI.Controls"
  xmlns:icons="using:Decor.AvaloniaUI.Icons"
        xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
        x:Class="Decor.AvaloniaUI.Views.ContextualSearchWindow"
        x:DataType="vm:ContextualSearchViewModel"
        Title="Pesquisar"
        Width="780"
        Height="580"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="14">
    <StackPanel Spacing="3">
      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <TextBlock Text="Selecione um resultado e confirme com OK." Foreground="{DynamicResource DecorTextMutedBrush}"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="SearchTextBox" Text="{Binding SearchText}" PlaceholderText="{Binding SearchHint}" MinHeight="40" FontSize="16" KeyDown="SearchTextBox_KeyDown"/>
      <Button Grid.Column="1" Classes="search-button" Command="{Binding SearchCommand}">
        <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
      </Button>
    </Grid>
    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
      <TextBlock Text="{Binding ResultCount}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
      <Panel Grid.Row="1">
        <controls:DecorDataGridControl x:Name="ResultsGrid" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"/>
        <Border Padding="10" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorDangerBrush}" BorderThickness="1" IsVisible="{Binding HasError}" VerticalAlignment="Top" ZIndex="2">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
        </Border>
      </Panel>
    </Grid>
    <Border Grid.Row="3" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancelar" Click="Cancel_Click" MinWidth="100"/>
        <Button Content="OK" Click="Accept_Click" IsEnabled="{Binding SelectedItem}" MinWidth="100" Background="{DynamicResource DecorAccentBrush}" Foreground="White"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>