<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.QuotesView"
             x:DataType="vm:QuotesViewModel">
  <UserControl.Styles>
    <Style Selector="Button.field-action, Button.search-button, Button.clear-search-button">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12" IsVisible="{Binding !IsEditing}">
      <Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox x:Name="SearchTextBox" Text="{Binding SearchText}" PlaceholderText="Pesquisar orçamentos por código ou cliente" KeyDown="SearchTextBox_KeyDown" BorderThickness="0"/>
        <Button Grid.Column="1" Classes="search-button" Command="{Binding SearchCommand}"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button>
        <Button Grid.Column="2" Classes="clear-search-button" Command="{Binding ClearSearchCommand}"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Clear}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button>
      </Grid>
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Novo orçamento" Command="{Binding NewCommand}"/><Button Content="Editar" Command="{Binding EditCommand}"/><Button Content="Excluir" Command="{Binding DeleteCommand}"/></StackPanel>
    </Grid>
    <Panel Grid.Row="1">
      <Grid RowDefinitions="Auto,*" RowSpacing="8" IsVisible="{Binding !IsEditing}">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
        <controls:DecorDataGridControl Grid.Row="1" x:Name="QuotesGrid" PaginationSource="{Binding}" DefaultSortMemberPath="QuoteID" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"/>
      </Grid>
      <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8" IsVisible="{Binding IsEditing}">
        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="16">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="36,*,*,90" ColumnSpacing="8">
            <Button Classes="field-action" Height="36" VerticalAlignment="Bottom" Command="{Binding CancelCommand}" ToolTip.Tip="Voltar à listagem"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Navigation.PreviousPage}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="Nº do orçamento" FontSize="12"/>
              <Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnDefinitions="*,36">
                  <TextBox Text="{Binding CurrentQuoteId}" IsReadOnly="True" BorderThickness="0"/>
                  <Button Grid.Column="1" Classes="field-action" Click="CopyQuoteNumber_Click" ToolTip.Tip="Copiar número"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Copy}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button>
                </Grid>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
              <TextBlock Text="Data" FontSize="12"/>
              <Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnDefinitions="*,36">
                  <TextBlock Text="{Binding QuoteDate, StringFormat='{}{0:dd/MM/yyyy}'}" Margin="10,0" VerticalAlignment="Center"/>
                  <Button x:Name="ChooseQuoteDateButton" Grid.Column="1" Classes="field-action" ToolTip.Tip="Selecionar data">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedRight">
                        <Calendar SelectedDate="{Binding SelectedQuoteDate, Mode=TwoWay}" SelectedDatesChanged="QuoteDateCalendar_SelectedDatesChanged"/>
                      </Flyout>
                    </Button.Flyout>
                    <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Calendar}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="2"><TextBlock Text="Estado" FontSize="12" HorizontalAlignment="Center"/><Grid Height="36"><TextBlock Text="CONVERTIDO" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource DecorTextMutedBrush}" IsVisible="{Binding IsQuoteConverted}"/><TextBlock Text="ABERTO" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#218647" IsVisible="{Binding IsQuoteOpen}"/><TextBlock Text="CANCELADO" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource DecorDangerBrush}" IsVisible="{Binding IsQuoteCancelled}"/></Grid></StackPanel>
          </Grid>
          <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><Path Margin="8" icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Profile}" Fill="{DynamicResource DecorTextMutedBrush}" Width="16" Height="16" Stretch="Uniform"/><TextBox Grid.Column="1" Text="{Binding CustomerSummary}" IsReadOnly="True" BorderThickness="0"/><Button Grid.Column="2" Classes="field-action" Command="{Binding ClearCustomerCommand}" IsVisible="{Binding HasSelectedCustomer}" ToolTip.Tip="Limpar cliente"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/></Button><Button Grid.Column="3" Classes="field-action" Click="SearchCustomer_Click" ToolTip.Tip="Pesquisar cliente"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button></Grid></Border>
            <Border Grid.Row="1" Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4"><Grid ColumnDefinitions="Auto,*,Auto,Auto"><Path Margin="8" icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Profile}" Fill="{DynamicResource DecorTextMutedBrush}" Width="16" Height="16" Stretch="Uniform"/><TextBox Grid.Column="1" Text="{Binding EmployeeSummary}" IsReadOnly="True" BorderThickness="0"/><Button Grid.Column="2" Classes="field-action" Command="{Binding ClearEmployeeCommand}" IsVisible="{Binding HasSelectedEmployee}" ToolTip.Tip="Limpar vendedor"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/></Button><Button Grid.Column="3" Classes="field-action" Click="SearchEmployee_Click" ToolTip.Tip="Pesquisar vendedor"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button></Grid></Border>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8"><TextBlock Text="Origem" FontSize="12" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Height="36" ItemsSource="{Binding SourceTypes}" SelectedItem="{Binding SourceType}"/></Grid>
          </Grid>
        </Grid>
        </Border>
          <Border Grid.Row="1" Background="{DynamicResource DecorSurfaceRaisedBrush}" CornerRadius="6" Padding="10">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding ProductSearchText}" PlaceholderText="Pesquisar produtos e serviços" BorderThickness="0"/>
              <Button Grid.Column="1" Classes="field-action" Command="{Binding SearchProductsCommand}" ToolTip.Tip="Pesquisar produtos"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button>
              <Button Grid.Column="2" Classes="field-action" Command="{Binding ClearProductsCommand}" ToolTip.Tip="Limpar pesquisa"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Clear}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button>
            </Grid>
            </Border>
            <TabControl Grid.Row="1" SelectedIndex="{Binding CatalogTabIndex}">
              <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.Products}" Fill="{DynamicResource DecorTextBrush}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="Produtos"/></StackPanel></TabItem.Header><controls:DecorDataGridControl x:Name="ProductsCatalogGrid" PaginationSource="{Binding CatalogPagination}" ItemsSource="{Binding CatalogProducts}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" DefaultSortMemberPath="Code"/></TabItem>
              <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" Spacing="6"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Modules.Servicos}" Fill="{DynamicResource DecorTextBrush}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="Serviços"/></StackPanel></TabItem.Header><controls:DecorDataGridControl x:Name="ServicesCatalogGrid" PaginationSource="{Binding CatalogPagination}" ItemsSource="{Binding CatalogServices}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" DefaultSortMemberPath="Code"/></TabItem>
            </TabControl>
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnDefinitions="130,*" ColumnSpacing="8">
              <StackPanel Spacing="4"><TextBlock Text="Quantidade"/><Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4"><Grid ColumnDefinitions="*,36"><NumericUpDown controls:QuoteNumericInput.Enabled="True" Value="{Binding QuantityValue}" Minimum="{Binding QuantityMinimum}" Maximum="{Binding QuantityMaximum}" Increment="1" FormatString="{Binding QuantityFormat}" BorderThickness="0" HorizontalContentAlignment="Right" AllowSpin="False" ShowButtonSpinner="False" ParsingNumberStyle="Number"/><TextBlock Grid.Column="1" Text="{Binding QuantityUnitLabel}" ToolTip.Tip="{Binding QuantityUnitDescription}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Valor de Venda"/><Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4"><Grid ColumnDefinitions="*,36"><NumericUpDown controls:QuoteNumericInput.Enabled="True" Value="{Binding SaleValue}" Minimum="0" Maximum="999999999" FormatString="N2" Increment="0.01" BorderThickness="0" HorizontalContentAlignment="Right" AllowSpin="False" ShowButtonSpinner="False" ParsingNumberStyle="Number"/><TextBlock Grid.Column="1" Text="{Binding CurrencySymbol}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></StackPanel>
              <Button Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Command="{Binding SaveLineCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cart}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="Adicionar item"/></StackPanel></Button>
            </Grid>
          </Grid>
          </Border>
          </Grid>
          <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="8">
            <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" CornerRadius="6" Padding="10">
              <controls:DecorDataGridControl x:Name="QuoteItemsGrid" ItemsSource="{Binding AllLines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}" DefaultSortMemberPath="Item"/>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource DecorSurfaceRaisedBrush}" CornerRadius="6" Padding="10" MaxHeight="230">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,140" ColumnSpacing="12" RowSpacing="4">
                <TextBlock Text="Subtotal"/><TextBlock Grid.Column="1" Text="{Binding QuoteTotal, StringFormat='{}{0:C2}'}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Text="Desconto" VerticalAlignment="Center"/><Border Grid.Row="1" Grid.Column="1" Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4"><Grid ColumnDefinitions="*,36"><NumericUpDown controls:QuoteNumericInput.Enabled="True" Value="{Binding DiscountValue}" Minimum="0" Maximum="{Binding QuoteTotal}" FormatString="N2" BorderThickness="0" HorizontalContentAlignment="Right" AllowSpin="False" ShowButtonSpinner="False" ParsingNumberStyle="Number"/><TextBlock Grid.Column="1" Text="{Binding CurrencySymbol}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
                <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#0066CC" Padding="8,4" CornerRadius="4"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><TextBlock Text="Total" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding NetTotal, StringFormat='{}{0:C2}'}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/></Grid></Border>
              </Grid>
              <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,4,0,0"><StackPanel Spacing="2"><TextBlock Text="Observações" FontSize="12"/><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding NotesLimit}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="80"/><TextBlock Text="{Binding NotesCounter}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource DecorTextMutedBrush}"/></StackPanel></Border>
            </Grid>
            </Border>
          </Grid>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
        <Border Grid.Row="2" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><WrapPanel HorizontalAlignment="Right">
          <Button Margin="0,0,8,0" Command="{Binding SaveCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="Salvar"/></StackPanel></Button>
          <Button Margin="0,0,8,0" Command="{Binding GeneratePdfCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Report}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="Gerar PDF"/></StackPanel></Button>
          <Button Margin="0,0,8,0" Command="{Binding CancelQuoteCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="Cancelar Orçamento"/></StackPanel></Button>
          <Button Command="{Binding ConvertToOrderCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="Converter em Pedido"/></StackPanel></Button>
        </WrapPanel></Border>
      </Grid>
      <Panel Background="{DynamicResource DecorOverlayBrush}" IsVisible="{Binding ShowDeleteConfirmation}" ZIndex="1000"><Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Background="{DynamicResource DecorSurfaceRaisedBrush}" Padding="24" CornerRadius="8"><StackPanel Spacing="16"><TextBlock Text="Confirmação de exclusão"/><TextBlock Text="{Binding DeleteConfirmationMessage}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Button Content="Sim, excluir" Command="{Binding ConfirmDeleteCommand}"/><Button Grid.Column="1" Content="Não, cancelar" Command="{Binding CancelDeleteCommand}"/></Grid></StackPanel></Border></Panel>
    </Panel>
  </Grid>
</UserControl>