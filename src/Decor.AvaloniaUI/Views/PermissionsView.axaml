<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:views="using:Decor.AvaloniaUI.Views"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:dtos="using:Decor.Core.DTOs"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.PermissionsView"
             x:DataType="vm:PermissionsViewModel">
  <TabControl Margin="16">
    <TabItem Header="Grupos">
      <views:RolesView DataContext="{Binding GroupPermissions}"/>
    </TabItem>
    <TabItem Header="Usuários" IsVisible="{Binding CanViewUserPermissions}">
      <Grid DataContext="{Binding UserPermissions}" x:DataType="vm:UserPermissionsViewModel"
            RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12" Margin="0,12,0,0" IsEnabled="{Binding !IsBusy}">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <controls:DecorSearchField Grid.ColumnSpan="3" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Pesquisar usuário"
                        SearchCommand="{Binding SearchCommand}" ClearCommand="{Binding ClearSearchCommand}"/>
          <Button Grid.Column="3" Command="{Binding AssignGroupsCommand}" Classes="decor-action">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Edit}" Fill="{DynamicResource DecorEditIndicatorBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Text="Associar grupos" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="220,200,*" ColumnSpacing="12">
          <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="dtos:AdministrativeUserDTO">
                <TextBlock Text="{Binding PresentationName}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox Grid.Column="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}"/>
          <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="12">
            <TextBlock Text="{Binding GroupNames, StringFormat='Grupos: {0}'}" TextWrapping="Wrap"/>
            <controls:DecorDataGridControl Grid.Row="1" ItemsSource="{Binding Permissions}"
                      DefaultSortMemberPath="FormName" IsReadOnly="True" GridLinesVisibility="Horizontal">
              <controls:DecorDataGridControl.Columns>
                <DataGridTextColumn x:DataType="vm:UserPermissionOption" Header="Formulário" Binding="{Binding FormName}" SortMemberPath="FormName" Width="*"/>
                <DataGridTextColumn x:DataType="vm:UserPermissionOption" Header="Ação" Binding="{Binding ActionName}" SortMemberPath="ActionName" Width="*"/>
                <DataGridTextColumn x:DataType="vm:UserPermissionOption" Header="Dos grupos" Binding="{Binding InheritedAccess}" SortMemberPath="InheritedAccess" Width="130"/>
                <DataGridTemplateColumn Header="Personalizada" Width="180" SortMemberPath="Selection">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:UserPermissionOption">
                      <ComboBox ItemsSource="{x:Static vm:UserPermissionOption.Choices}"
                                SelectedItem="{Binding Selection, Mode=TwoWay}" IsEnabled="{Binding CanCustomize}" HorizontalAlignment="Stretch"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:DataType="vm:UserPermissionOption" Header="Efetiva" Binding="{Binding EffectiveAccess}" SortMemberPath="EffectiveAccess" Width="130"/>
              </controls:DecorDataGridControl.Columns>
            </controls:DecorDataGridControl>
          </Grid>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        <Border Grid.Row="3" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding RestoreCommand}" Classes="decor-action">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Backup}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Restaurar herança" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding SaveCommand}" Classes="decor-action">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{DynamicResource DecorAccentBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Salvar permissões" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>