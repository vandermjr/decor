<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.DatabaseMaintenanceView"
             x:DataType="vm:DatabaseMaintenanceViewModel">
  <TabControl Margin="12">
    <TabItem Header="Backup">
  <Grid Margin="16" RowDefinitions="Auto,*" RowSpacing="12" IsEnabled="{Binding CanUseBackup}">
    <StackPanel Spacing="4">
      <TextBlock Text="Backup do banco de dados" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="760" MinWidth="620"/>
      </Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Background="{DynamicResource DecorSurfaceRaisedBrush}">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="Agendamentos" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <TextBlock Text="Rotinas ativas e pausadas" Foreground="{DynamicResource DecorTextMutedBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" TabIndex="0" Command="{Binding NewScheduleCommand}" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Novo"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" TabIndex="1" Command="{Binding DeleteSelectedScheduleCommand}" IsVisible="{Binding HasSelectedSchedule}" Background="{DynamicResource DecorDangerBrush}" Foreground="White" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Delete}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Excluir"/>
              </StackPanel>
            </Button>
          </Grid>

          <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource DecorControlBrush}">
            <Grid>
              <TextBlock Text="Nenhum agendamento criado" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DecorTextMutedBrush}" IsVisible="{Binding !HasSchedules}"/>
              <ListBox x:Name="SchedulesList" ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}" IsVisible="{Binding HasSchedules}" Background="Transparent" BorderThickness="0" PointerReleased="SchedulesList_PointerReleased">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="MinHeight" Value="78"/>
                    <Setter Property="Padding" Value="10,8"/>
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BackupScheduleItemViewModel">
                    <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding TimeDisplay}" FontSize="26" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeriodDisplay}" Foreground="{DynamicResource DecorTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DestinationsDisplay}" Foreground="{DynamicResource DecorAccentBrush}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" OnContent="Ativo" OffContent="Pausado" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="12" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>

      <ScrollViewer Grid.Column="2" MinWidth="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
          <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Background="{DynamicResource DecorSurfaceRaisedBrush}">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding EditorTitle}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <Grid ColumnDefinitions="260,220,*" ColumnSpacing="18">
                <StackPanel Spacing="4">
                  <TextBlock Text="Data inicial" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                  <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Background="{DynamicResource DecorControlBrush}" CornerRadius="4" MinHeight="34">
                    <Grid ColumnDefinitions="*,38">
                      <TextBlock Text="{Binding BackupDateDisplay}" Margin="10,0" VerticalAlignment="Center"/>
                      <Button x:Name="ChooseBackupDateButton" Grid.Column="1" TabIndex="3" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ChooseBackupDateButton_Click" ToolTip.Tip="Selecionar data">
                        <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedRight">
                            <Border Padding="12" Background="{DynamicResource DecorSurfaceRaisedBrush}">
                              <StackPanel Spacing="10">
                                <Calendar x:Name="BackupDateCalendar" SelectedDate="{Binding BackupDate, Mode=TwoWay}" SelectedDatesChanged="BackupDateCalendar_SelectedDatesChanged"/>
                              </StackPanel>
                            </Border>
                          </Flyout>
                        </Button.Flyout>
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DecorTextBrush}" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Calendar}"/>
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Horário inicial" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                  <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Background="{DynamicResource DecorControlBrush}" CornerRadius="4" MinHeight="34">
                    <Grid ColumnDefinitions="*,38">
                      <TextBlock Text="{Binding BackupTimeDisplay}" Margin="10,0" VerticalAlignment="Center"/>
                      <Button x:Name="ChooseBackupTimeButton" Grid.Column="1" TabIndex="4" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ChooseBackupTimeButton_Click" ToolTip.Tip="Selecionar horário">
                        <Button.Flyout>
                          <Flyout Placement="BottomEdgeAlignedRight">
                            <Border Padding="12" Background="{DynamicResource DecorSurfaceRaisedBrush}">
                              <StackPanel Spacing="10">
                                <TimePickerPresenter x:Name="BackupTimePicker" Time="{Binding BackupTime, Mode=TwoWay}" ClockIdentifier="24HourClock" UseSeconds="False" Confirmed="BackupTimePicker_Confirmed" Dismissed="BackupTimePicker_Dismissed"/>
                              </StackPanel>
                            </Border>
                          </Flyout>
                        </Button.Flyout>
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DecorTextBrush}" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Clock}"/>
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Bottom" Foreground="{DynamicResource DecorTextMutedBrush}" Text="A data e o horário definem quando o agendamento começa." TextWrapping="Wrap"/>
              </Grid>

              <StackPanel Spacing="8">
                <TextBlock Text="Repetição" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton TabIndex="5" Content="Uma vez" IsChecked="{Binding IsOnceBackup}" GroupName="BackupRecurrence"/>
                  <RadioButton TabIndex="6" Content="Diariamente" IsChecked="{Binding IsDailyBackup}" GroupName="BackupRecurrence"/>
                  <RadioButton TabIndex="7" Content="Seg a Sex" IsChecked="{Binding IsWeekdaysBackup}" GroupName="BackupRecurrence"/>
                  <RadioButton TabIndex="8" Content="Personalizar" IsChecked="{Binding IsCustomBackup}" GroupName="BackupRecurrence"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsCustomBackup}">
                  <CheckBox TabIndex="9" Content="Seg" IsChecked="{Binding BackupOnMonday}"/>
                  <CheckBox TabIndex="10" Content="Ter" IsChecked="{Binding BackupOnTuesday}"/>
                  <CheckBox TabIndex="11" Content="Qua" IsChecked="{Binding BackupOnWednesday}"/>
                  <CheckBox TabIndex="12" Content="Qui" IsChecked="{Binding BackupOnThursday}"/>
                  <CheckBox TabIndex="13" Content="Sex" IsChecked="{Binding BackupOnFriday}"/>
                  <CheckBox TabIndex="14" Content="Sáb" IsChecked="{Binding BackupOnSaturday}"/>
                  <CheckBox TabIndex="15" Content="Dom" IsChecked="{Binding BackupOnSunday}"/>
                </StackPanel>
                <TextBlock Text="{Binding PeriodDisplay}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NextExecutionPreviewDisplay}" Foreground="{DynamicResource DecorAccentBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Background="{DynamicResource DecorSurfaceRaisedBrush}">
            <StackPanel Spacing="14">
              <TextBlock Text="Destino" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>

              <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="160,*,Auto" ColumnSpacing="12" RowSpacing="4">
                  <CheckBox TabIndex="16" Content="Pasta específica" IsChecked="{Binding UseSpecificFolder}" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" TabIndex="17" Text="{Binding SpecificFolderPath}" PlaceholderText="Ex.: /home/usuario/backups/decor" IsEnabled="{Binding UseSpecificFolder}"/>
                  <Button Grid.Column="2" TabIndex="18" IsEnabled="{Binding UseSpecificFolder}" Click="ChooseSpecificFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Folder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                      <TextBlock Text="Escolher"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Foreground="{DynamicResource DecorAccentBrush}" TextWrapping="Wrap" IsVisible="{Binding HasSpecificFolderBackupPath}">
                    <Run Text="Destino: "/><Run Text="{Binding SpecificFolderBackupPath}"/>
                  </TextBlock>
                </Grid>

                <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="160,*,Auto" ColumnSpacing="12" RowSpacing="4">
                  <CheckBox TabIndex="19" Content="Unidade externa" IsChecked="{Binding UseExternalDrive}" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" TabIndex="20" Text="{Binding ExternalDrivePath}" PlaceholderText="Ex.: /media/backup/decor" IsEnabled="{Binding UseExternalDrive}"/>
                  <Button Grid.Column="2" TabIndex="21" IsEnabled="{Binding UseExternalDrive}" Click="ChooseExternalDrive_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Folder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                      <TextBlock Text="Escolher"/>
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Foreground="{DynamicResource DecorAccentBrush}" TextWrapping="Wrap" IsVisible="{Binding HasExternalDriveBackupPath}">
                    <Run Text="Destino: "/><Run Text="{Binding ExternalDriveBackupPath}"/>
                  </TextBlock>
                </Grid>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource DecorAccentBrush}" TextWrapping="Wrap" IsVisible="{Binding HasSummary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                  <Button TabIndex="22" Command="{Binding StartImmediateBackupCommand}" IsEnabled="{Binding !IsBackupRunning}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Backup}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                      <TextBlock Text="{Binding ImmediateBackupButtonText}"/>
                    </StackPanel>
                  </Button>
                  <Button TabIndex="23" Command="{Binding SaveScheduleCommand}" Background="{DynamicResource DecorAccentBrush}" Foreground="{DynamicResource DecorSelectionForegroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                      <TextBlock Text="Salvar agendamento"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
    </TabItem>
    <TabItem Header="Restauração">
      <ScrollViewer Margin="16" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="Restaurar banco de dados" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          <TextBlock Text="A restauração substitui as tabelas contidas no backup. Feche as outras sessões antes de continuar. Utilize somente um ZIP gerado pelo Decor e obtido de uma origem confiável." TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding RestoreFile}" IsReadOnly="True" PlaceholderText="Arquivo ZIP do backup" MinWidth="360"/>
            <Button Grid.Column="1" Click="ChooseRestoreFile_Click" IsEnabled="{Binding CanRestore}" ToolTip.Tip="Selecionar backup">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Folder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Selecionar arquivo"/>
              </StackPanel>
            </Button>
          </Grid>
          <Button Command="{Binding RequestRestoreCommand}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Database}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
              <TextBlock Text="Restaurar banco"/>
            </StackPanel>
          </Button>
          <StackPanel Spacing="12" IsVisible="{Binding ShowRestoreConfirmation}" IsEnabled="{Binding !IsRestoring}">
            <TextBlock Text="Esta operação altera os dados atuais e não possui reversão automática. Uma cópia de segurança será criada ao lado do arquivo selecionado. Confirme digitando RESTAURAR BANCO." Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
            <TextBox Text="{Binding RestoreConfirmation}" PlaceholderText="RESTAURAR BANCO"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding CancelRestoreCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                  <TextBlock Text="Cancelar"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding ConfirmRestoreCommand}" Background="{DynamicResource DecorDangerBrush}" Foreground="White">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Database}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                  <TextBlock Text="Confirmar restauração"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRestoring}" Height="4"/>
          <TextBlock Text="{Binding RestoreStatus}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SafetyBackupFile, StringFormat='Cópia de segurança: {0}'}" IsVisible="{Binding RestoreCompleted}" TextWrapping="Wrap"/>
          <Button Command="{Binding FinishRestoreCommand}" IsVisible="{Binding RestoreCompleted}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.SignOut}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
              <TextBlock Text="Encerrar sessão"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
