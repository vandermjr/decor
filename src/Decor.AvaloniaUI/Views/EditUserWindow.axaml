<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
        xmlns:icons="using:Decor.AvaloniaUI.Icons"
        x:Class="Decor.AvaloniaUI.Views.EditUserWindow"
        x:DataType="vm:EditUserViewModel"
        Title="Decor — Editar usuário"
        Width="620" Height="360" MinWidth="560" MinHeight="340"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="*,Auto" RowSpacing="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="Editar usuário" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ProgressBar Width="60" Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
      <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Código" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding UserCodeDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Estado" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
          <ToggleSwitch TabIndex="1" IsChecked="{Binding IsActive, Mode=TwoWay}" OnContent="Ativo" OffContent="Bloqueado" MinWidth="135" IsEnabled="{Binding CanChangeActive}"/>
        </StackPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="4">
      <TextBlock Text="Usuário" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <TextBox TabIndex="0" Text="{Binding Username}" MaxLength="50" IsEnabled="{Binding CanEditFields}"/>
    </StackPanel>
    <Border Grid.Row="3" VerticalAlignment="Top" Padding="10" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorDangerBrush}" BorderThickness="1" IsVisible="{Binding HasError}">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
    </Border>
  </Grid>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button TabIndex="2" Command="{Binding SaveCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="Salvar" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button TabIndex="3" Command="{Binding CancelCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>