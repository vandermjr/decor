<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             x:Class="Decor.AvaloniaUI.Views.IconCatalogView"
             x:DataType="vm:IconCatalogViewModel">
  <UserControl.Styles>
    <Style Selector="Border.icon-card">
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Width" Value="170"/>
      <Setter Property="Height" Value="176"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18" Spacing="22">
      <StackPanel Spacing="4">
        <TextBlock Text="Configurações do Sistema" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
        <TextBlock Text="Aparência global dos ícones do sistema." Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Background="{DynamicResource DecorSurfaceRaisedBrush}"
              BorderBrush="{DynamicResource DecorBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="Aparência dos ícones" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Peso do ícone" VerticalAlignment="Center"/>
            <Slider Grid.Row="0" Grid.Column="1"
                    Minimum="100" Maximum="700" TickFrequency="100" IsSnapToTickEnabled="True"
                    Value="{Binding IconWeight, Mode=TwoWay}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding IconWeightDisplay}" VerticalAlignment="Center"/>

          </Grid>
          <Button HorizontalAlignment="Right" Command="{Binding ApplyCommand}" Content="Salvar"/>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding FamilyGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:IconCatalogFamilyViewModel">
            <Border Margin="0,0,0,18" Padding="0" Background="Transparent">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>

                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IconCatalogItemViewModel">
                      <Border Classes="icon-card">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                          <Path Data="{Binding Geometry}"
                                Width="42"
                                Height="42"
                                Stretch="Uniform"
                              Fill="{DynamicResource DecorTextBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                          <TextBlock Text="{Binding Name}"
                                     FontWeight="{DynamicResource DecorFontWeightHeading}"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center"/>

                          <TextBlock Text="{Binding FullId}"
                                     Foreground="{DynamicResource DecorTextMutedBrush}"
                                     FontSize="{DynamicResource DecorFontSizeCaption}"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="140"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
