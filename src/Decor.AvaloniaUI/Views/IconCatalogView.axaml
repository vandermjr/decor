<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             x:Class="Decor.AvaloniaUI.Views.IconCatalogView"
             x:DataType="vm:IconCatalogViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="GridAppearanceColorOptionTemplate" x:DataType="vm:GridAppearanceColorOption">
      <Border Width="270" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,0,1,0" Padding="0,0,8,0" Margin="0,0,12,8">
        <Grid ColumnDefinitions="*,100,24" ColumnSpacing="8">
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
          <TextBox Grid.Column="1" Text="{Binding ColorHex, Mode=TwoWay}" MaxLength="9" ToolTip.Tip="Cor hexadecimal"/>
          <Border Grid.Column="2" Width="22" Height="22" CornerRadius="3" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Background="{Binding PreviewBrush}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.logo-position-button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="7"/>
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.logo-position-button:disabled">
      <Setter Property="Opacity" Value="0.38"/>
    </Style>
    <Style Selector="Border.icon-card">
      <Setter Property="Background" Value="{DynamicResource DecorSurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Width" Value="170"/>
      <Setter Property="Height" Value="176"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto,Auto" ColumnDefinitions="230,Auto,*" ColumnSpacing="16" Margin="{DynamicResource DecorPageMargin}">
    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="Todas as opções" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Height="1" Background="{DynamicResource DecorBorderBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <TreeView x:Name="SettingsTree" SelectionChanged="SettingsTree_SelectionChanged">
        <TreeViewItem Header="Aparência" IsExpanded="True">
          <TreeViewItem Header="Tema" Tag="Theme" IsSelected="True"/>
          <TreeViewItem Header="Ícones" Tag="Icons"/>
          <TreeViewItem Header="Logo da empresa" Tag="LoginBranding"/>
          <TreeViewItem Header="Grades" Tag="GridAppearance"/>
        </TreeViewItem>
        <TreeViewItem Header="Estoque" IsExpanded="True">
          <TreeViewItem Header="Movimentações" Tag="StockMovements"/>
        </TreeViewItem>
        <TreeViewItem Header="Notificações" IsExpanded="True">
          <TreeViewItem Header="Backup" Tag="BackupNotifications" IsSelected="True"/>
        </TreeViewItem>
      </TreeView>
    </StackPanel>

    <Border Grid.Column="1" Grid.RowSpan="3" Width="1" Background="{DynamicResource DecorBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

    <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <Border Padding="0,0,16,0" HorizontalAlignment="Stretch">
      <StackPanel Spacing="18" HorizontalAlignment="Stretch">
        <StackPanel IsVisible="{Binding IsLoginBrandingSelected}" Spacing="12">
          <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="14">
                <TextBlock Text="Logo da empresa" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                <TextBlock Text="{Binding LoginLogoFileName}" Foreground="{DynamicResource DecorTextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Recomendado: 1200 × 760 px. Formatos aceitos: PNG (com transparência) ou JPEG, até 10 MB. Outras dimensões também são aceitas." Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" TextWrapping="Wrap"/>
                <CheckBox Content="Inverter cores da logo no tema claro" IsChecked="{Binding InvertLoginLogoInLightTheme, Mode=TwoWay}"/>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <TextBlock Text="Tamanho" VerticalAlignment="Center"/>
                  <Slider Grid.Column="1" Minimum="25" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding LoginLogoSizePercent, Mode=TwoWay}" AutomationProperties.Name="Tamanho da logo da empresa"/>
                  <TextBlock Grid.Column="2" Text="{Binding LoginLogoSizeDisplay}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"/>
                </Grid>
                <StackPanel Spacing="6">
                  <TextBlock Text="Posição da imagem"/>
                  <TextBlock Text="Use as setas para ajustar a posição da imagem." Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
                  <Grid Width="112" Height="104" RowDefinitions="32,32,32" ColumnDefinitions="32,32,32" HorizontalAlignment="Left">
                    <Button Grid.Row="0" Grid.Column="1" Command="{Binding MoveLoginLogoUpCommand}" IsEnabled="{Binding CanMoveLoginLogoUp}" Classes="logo-position-button" ToolTip.Tip="Mover imagem para cima">
                      <Path Data="M12,3 L4,11 H9 V21 H15 V11 H20 Z" Fill="{DynamicResource DecorTextBrush}" Stretch="Uniform"/>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="0" Command="{Binding MoveLoginLogoLeftCommand}" IsEnabled="{Binding CanMoveLoginLogoLeft}" Classes="logo-position-button" ToolTip.Tip="Mover imagem para a esquerda">
                      <Path Data="M3,12 L11,4 V9 H21 V15 H11 V20 Z" Fill="{DynamicResource DecorTextBrush}" Stretch="Uniform"/>
                    </Button>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="+" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DecorTextMutedBrush}" ToolTip.Tip="Centro das posições"/>
                    <Button Grid.Row="1" Grid.Column="2" Command="{Binding MoveLoginLogoRightCommand}" IsEnabled="{Binding CanMoveLoginLogoRight}" Classes="logo-position-button" ToolTip.Tip="Mover imagem para a direita">
                      <Path Data="M21,12 L13,4 V9 H3 V15 H13 V20 Z" Fill="{DynamicResource DecorTextBrush}" Stretch="Uniform"/>
                    </Button>
                    <Button Grid.Row="2" Grid.Column="1" Command="{Binding MoveLoginLogoDownCommand}" IsEnabled="{Binding CanMoveLoginLogoDown}" Classes="logo-position-button" ToolTip.Tip="Mover imagem para baixo">
                      <Path Data="M12,21 L4,13 H9 V3 H15 V13 H20 Z" Fill="{DynamicResource DecorTextBrush}" Stretch="Uniform"/>
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding LoginLogoPositionDisplay}" FontSize="{DynamicResource DecorFontSizeCaption}" Foreground="{DynamicResource DecorTextMutedBrush}"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                <TextBlock Text="Prévia" HorizontalAlignment="Left" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                <Border Width="320" Height="193" ClipToBounds="True" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
                  <Grid ColumnDefinitions="124,*" FlowDirection="LeftToRight">
                    <Border Grid.ColumnSpan="2" Background="{DynamicResource LoginBrandingBackgroundBrush}"/>
                    <Border Grid.Column="1" Background="{DynamicResource LoginImageColumnBrush}"/>
                    <Image Grid.Column="1" Source="{Binding LoginLogoPreview}" Stretch="Uniform"
                           Width="{Binding LoginLogoPreviewWidth}" MaxHeight="124" Margin="11"
                           HorizontalAlignment="{Binding LoginLogoHorizontalAlignment}" VerticalAlignment="{Binding LoginLogoVerticalAlignment}"
                           AutomationProperties.Name="Prévia da logo da empresa"/>
                    <Border Grid.Column="0" Background="{DynamicResource LoginGlassPanelBrush}" Padding="8,10">
                      <Grid RowDefinitions="*,Auto">
                        <Grid Grid.Row="0" MaxWidth="76" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5.5">
                          <TextBlock Text="Bem-vindo!" Foreground="{DynamicResource LoginGlassTextBrush}"
                                     FontSize="11" FontWeight="{DynamicResource DecorFontWeightHeading}"
                                     Margin="0,0,0,8" HorizontalAlignment="Center" TextAlignment="Center"/>
                          <Border Grid.Row="1" Height="13" Background="{DynamicResource LoginGlassFieldBrush}"
                                  BorderBrush="{DynamicResource LoginGlassBorderBrush}" BorderThickness="0.35" CornerRadius="5">
                            <TextBlock Text="Código do usuário" FontSize="4.5" Foreground="{DynamicResource LoginGlassFieldTextBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Border>
                          <Border Grid.Row="2" Height="13" Background="{DynamicResource LoginGlassFieldBrush}"
                                  BorderBrush="{DynamicResource LoginGlassBorderBrush}" BorderThickness="0.35" CornerRadius="5">
                            <TextBlock Text="Senha" FontSize="4.5" Foreground="{DynamicResource LoginGlassFieldTextBrush}"
                                       VerticalAlignment="Center" Margin="4,0"/>
                          </Border>
                          <Border Grid.Row="5" BoxShadow="0 1 3 0 #80000000" CornerRadius="8">
                            <Border Background="#FF9B76" CornerRadius="8" Height="16">
                              <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Width="6" Height="6" Stretch="Uniform" Fill="#34231D" icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.SignIn}"/>
                                <TextBlock Text="Entrar" FontSize="5" FontWeight="SemiBold" Foreground="#34231D" VerticalAlignment="Center"/>
                              </StackPanel>
                            </Border>
                          </Border>
                        </Grid>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,0.35,0,0" Padding="0,4,0,0">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <TextBlock Text="Versão 1.0.0.0" Foreground="{DynamicResource LoginGlassMutedTextBrush}" FontSize="4" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                              <PathIcon Width="6" Height="6" Foreground="{DynamicResource LoginGlassMutedTextBrush}"
                                        icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Database}"/>
                              <TextBlock Text="Online" Foreground="{DynamicResource LoginGlassMutedTextBrush}" FontSize="4"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                  <Button Width="28" Height="28" Padding="6" Click="ChooseLoginLogoButton_Click" Classes="decor-action" ToolTip.Tip="Alterar imagem da empresa" AutomationProperties.Name="Alterar imagem da empresa">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DecorTextBrush}" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Edit}"/>
                  </Button>
                  <Button Width="28" Height="28" Padding="6" Command="{Binding RemoveLoginLogoCommand}" Classes="decor-action" ToolTip.Tip="Remover imagem da empresa" AutomationProperties.Name="Remover imagem da empresa">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DecorDangerBrush}" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Delete}"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="{Binding LoginBrandingStatus}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsGridAppearanceSelected}" Spacing="10" HorizontalAlignment="Stretch">
          <TextBlock Text="Aparência das grades" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          <Expander Header="Aparência geral" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12" Margin="8,10,8,8">
              <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <TextBlock Text="Paleta" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GridAppearance.PaletteOptions}" SelectedItem="{Binding GridAppearance.SelectedPalette, Mode=TwoWay}"/>
                <TextBlock Grid.Row="1" Text="Família da fonte" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding GridAppearance.FontFamilies}" SelectedItem="{Binding GridAppearance.FontFamily, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Text="Tamanho do texto" VerticalAlignment="Center"/>
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,52" ColumnSpacing="10">
                  <Slider Minimum="9" Maximum="{Binding GridAppearance.MaximumFontSize}" TickFrequency="0.1" Value="{Binding GridAppearance.FontSize, Mode=TwoWay}"/>
                  <TextBlock Grid.Column="1" Text="{Binding GridAppearance.FontSize, StringFormat='{}{0:0.0}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>
                <TextBlock Grid.Row="3" Text="Peso dos cabeçalhos" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding GridAppearance.FontWeights}" SelectedItem="{Binding GridAppearance.HeaderFontWeight, Mode=TwoWay}"/>
                <TextBlock Grid.Row="4" Text="Peso das células" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding GridAppearance.FontWeights}" SelectedItem="{Binding GridAppearance.CellFontWeight, Mode=TwoWay}"/>
                <TextBlock Grid.Row="5" Text="Altura das linhas" VerticalAlignment="Center"/>
                <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,52" ColumnSpacing="10">
                  <Slider Minimum="20" Maximum="80" TickFrequency="2" Value="{Binding GridAppearance.RowHeight, Mode=TwoWay}"/>
                  <TextBlock Grid.Column="1" Text="{Binding GridAppearance.RowHeight, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>
                <TextBlock Grid.Row="6" Text="Alinhamento dos cabeçalhos" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding GridAppearance.HeaderAlignmentOptions}" SelectedItem="{Binding GridAppearance.HeaderAlignment, Mode=TwoWay}"/>
                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Alinhamento das linhas por tipo" FontWeight="{DynamicResource DecorFontWeightHeading}" Margin="0,4,0,0"/>
                <ItemsControl Grid.Row="8" Grid.ColumnSpan="2" ItemsSource="{Binding GridAppearance.RowAlignments}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GridAppearanceAlignmentOption">
                      <Grid Width="250" ColumnDefinitions="*,120" ColumnSpacing="8" Margin="0,0,12,8">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AlignmentOptions}" SelectedItem="{Binding SelectedAlignment, Mode=TwoWay}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
              <Grid ColumnDefinitions="160,*,52" ColumnSpacing="12">
                <TextBlock Text="Altura dos cabeçalhos" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="28" Maximum="64" TickFrequency="2" Value="{Binding GridAppearance.HeaderHeight, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="{Binding GridAppearance.HeaderHeight, StringFormat='{}{0:0} px'}" VerticalAlignment="Center" TextAlignment="Right"/>
              </Grid>
              <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                <TextBlock Text="Peso das descrições" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GridAppearance.FontWeights}" SelectedItem="{Binding GridAppearance.DescriptionFontWeight, Mode=TwoWay}"/>
              </Grid>
              <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                <TextBlock Text="Divisórias" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GridAppearance.GridLinesOptions}" SelectedItem="{Binding GridAppearance.GridLinesOption, Mode=TwoWay}"/>
              </Grid>
              <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                <TextBlock Text="Cabeçalhos visíveis" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GridAppearance.HeadersVisibilityOptions}" SelectedItem="{Binding GridAppearance.HeadersVisibilityOption, Mode=TwoWay}"/>
              </Grid>
            </StackPanel>
          </Expander>
          <Expander Header="Superfícies e seleção" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding GridAppearance.SurfaceColors}" Margin="8,10,8,8" ItemTemplate="{StaticResource GridAppearanceColorOptionTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </Expander>
          <Expander Header="Cores semânticas" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding GridAppearance.SemanticColors}" Margin="8,10,8,8" ItemTemplate="{StaticResource GridAppearanceColorOptionTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </Expander>
          <TextBlock Text="{Binding GridAppearance.Status}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsThemeSettingsSelected}" Spacing="18">
          <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="14">
              <TextBlock Text="Tema" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <TextBlock Text="Escolha a aparência visual do sistema para todos os módulos do aplicativo." Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
              <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Background="{DynamicResource DecorControlBrush}" MaxHeight="120"/>
              <TextBlock Text="{Binding ThemeSettingsStatus}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsStockMovementsSelected}" Spacing="12">
          <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="12">
              <TextBlock Text="Estoque / Movimentações" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <ToggleSwitch Content="Permitir venda com estoque negativo" IsChecked="{Binding AllowNegativeStock, Mode=TwoWay}"/>
              <TextBlock Text="Quando desativado, a venda é bloqueada se a quantidade exceder o saldo disponível. Quando ativado, a venda pode prosseguir após confirmação." Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding StockSettingsStatus}" Margin="0,4,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsBackupNotificationsSelected}" Spacing="12">
          <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="12">
              <TextBlock Text="Backup agendado" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <ToggleSwitch Content="Notificar antes do backup agendado" IsChecked="{Binding NotifyBeforeScheduledBackup, Mode=TwoWay}"/>
              <Grid ColumnDefinitions="*,260" ColumnSpacing="12" IsEnabled="{Binding NotifyBeforeScheduledBackup}">
                <TextBlock Text="Avisar antes do backup (horas:minutos)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Border Grid.Column="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Background="{DynamicResource DecorControlBrush}" CornerRadius="4" Height="36" ClipToBounds="True">
                  <Grid ColumnDefinitions="*,36">
                    <TextBlock Text="{Binding BackupNotificationLeadTimeDisplay}" Margin="10,0" VerticalAlignment="Center"/>
                    <Button x:Name="ChooseBackupNotificationLeadTimeButton" Classes="field-action decor-action" Grid.Column="1" Click="ChooseBackupNotificationLeadTimeButton_Click" ToolTip.Tip="Selecionar antecedência">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                          <Border Padding="12" Background="{DynamicResource DecorSurfaceRaisedBrush}">
                            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Antecedência" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="decor-flyout-close" Click="CloseBackupNotificationLeadTimeFlyout_Click" ToolTip.Tip="Fechar"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/></Button></Grid>
                              <TimePickerPresenter Grid.Row="1" x:Name="BackupNotificationLeadTimePicker" Time="{Binding BackupNotificationLeadTime, Mode=TwoWay}" ClockIdentifier="24HourClock" UseSeconds="False" Confirmed="BackupNotificationLeadTimePicker_Confirmed" Dismissed="BackupNotificationLeadTimePicker_Dismissed"/>
                            </Grid>
                          </Border>
                        </Flyout>
                      </Button.Flyout>
                      <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DecorTextBrush}" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Clock}"/>
                    </Button>
                  </Grid>
                </Border>
              </Grid>
              <TextBlock Text="{Binding NextBackupNotificationPreview}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding BackupNotificationSettingsStatus}" Margin="0,4,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsIconSettingsSelected}" Spacing="18">
          <Border Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="12">
              <TextBlock Text="Aparência dos ícones" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Text="Peso do ícone" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="100" Maximum="700" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding IconWeight, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="{Binding IconWeightDisplay}" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding IconAppearanceStatus}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding FamilyGroups}" HorizontalAlignment="Stretch">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IconCatalogFamilyViewModel">
                <Expander Header="{Binding Name}" IsExpanded="True" Margin="0,0,0,18" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:IconCatalogItemViewModel">
                        <Border Classes="icon-card">
                          <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                              <Path Data="{Binding Geometry}" Width="42" Height="42" Stretch="Uniform" Fill="{Binding ColorPreviewBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Name}" FontWeight="{DynamicResource DecorFontWeightHeading}" HorizontalAlignment="Center" TextAlignment="Center"/>
                              <TextBlock Text="{Binding FullId}" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            </StackPanel>

                            <Button Grid.Row="1" Grid.Column="1" Width="30" Height="30" CornerRadius="15" BorderThickness="1" BorderBrush="{DynamicResource DecorBorderBrush}" Background="{Binding ColorPreviewBrush}" ToolTip.Tip="Escolher cor do ícone" Click="IconColorChoiceButton_Click">
                              <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                  <Border Padding="10" Background="{DynamicResource DecorSurfaceRaisedBrush}">
                                  <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Cor do ícone" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="decor-flyout-close" Click="CloseIconColorPalette_Click" ToolTip.Tip="Fechar"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/></Button></Grid>
                                  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Width="22" Height="22" CornerRadius="11" Background="#ef4444" Tag="#ef4444" Click="IconColorChoice_Click"/>
                                    <Button Width="22" Height="22" CornerRadius="11" Background="#f59e0b" Tag="#f59e0b" Click="IconColorChoice_Click"/>
                                    <Button Width="22" Height="22" CornerRadius="11" Background="#10b981" Tag="#10b981" Click="IconColorChoice_Click"/>
                                    <Button Width="22" Height="22" CornerRadius="11" Background="#3b82f6" Tag="#3b82f6" Click="IconColorChoice_Click"/>
                                    <Button Width="22" Height="22" CornerRadius="11" Background="#8b5cf6" Tag="#8b5cf6" Click="IconColorChoice_Click"/>
                                    <Button Width="22" Height="22" CornerRadius="11" Background="#ffffff" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Tag="#ffffff" Click="IconColorChoice_Click"/>
                                    <Button Width="22" Height="22" CornerRadius="11" Background="#000000" Tag="#000000" Click="IconColorChoice_Click"/>
                                    <Button Content="Restaurar padrão" Classes="decor-action" Tag="" Click="IconColorReset_Click"/>
                                  </StackPanel>
                                  </Grid>
                                  </Border>
                                </Flyout>
                              </Button.Flyout>
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
      </Border>
    </ScrollViewer>

    <StackPanel Grid.Column="2" Grid.Row="1" IsVisible="{Binding IsGridAppearanceSelected}" Margin="0,8,16,0" Spacing="6">
      <Border Height="1" Background="{DynamicResource DecorBorderBrush}"/>
      <TextBlock Text="Prévia" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <controls:DecorDataGridControl x:Name="GridAppearancePreview" ItemsSource="{Binding GridAppearance.PreviewRows}" AppearanceThemeOverride="{Binding GridAppearance.PreviewIsDark}" HorizontalAlignment="Stretch" Height="150"/>
    </StackPanel>

    <Border Grid.Column="2" Grid.Row="2" Padding="16,12,16,12" Margin="0,12,0,0" Background="Transparent">
      <StackPanel Spacing="8">
        <Border Height="1" Background="{DynamicResource DecorBorderBrush}"/>
        <TextBlock Text="{Binding IconColorStatus}" Foreground="{DynamicResource DecorDangerBrush}" IsVisible="{Binding IconColorStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Text="{Binding GridAppearance.Status}" Foreground="{DynamicResource DecorDangerBrush}" IsVisible="{Binding IsGridAppearanceSelected}"/>
        <Button Command="{Binding ResetSelectedSettingsCommand}" Classes="decor-action" Content="{Binding ResetSelectedSettingsText}" HorizontalAlignment="Right"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
