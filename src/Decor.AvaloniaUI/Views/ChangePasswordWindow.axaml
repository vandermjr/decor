<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
        x:Class="Decor.AvaloniaUI.Views.ChangePasswordWindow"
        x:DataType="vm:ChangePasswordViewModel"
        Title="Decor — Alterar senha"
        Width="420"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Flyout x:Key="PasswordRequirementsFlyout" ShowMode="Transient" Placement="BottomEdgeAlignedRight">
      <Border MaxWidth="290" Padding="12" Background="{DynamicResource DecorSurfaceRaisedBrush}"
              BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
        <StackPanel Spacing="4">
          <TextBlock Text="Requisitos da nova senha" FontWeight="{DynamicResource DecorFontWeightHeading}" />
          <TextBlock Text="Deve ter entre 12 e 128 caracteres, não pode ser composta apenas por espaços e deve ser diferente da senha atual."
                     Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Flyout>
  </Window.Resources>
  <Grid Margin="36" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}" />
      <TextBlock Text="{Binding Description}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="6" IsVisible="{Binding IsCurrentPasswordRequired}">
      <Grid>
        <TextBox TabIndex="0" Text="{Binding CurrentPassword}" PasswordChar="●" Classes="revealPasswordButton"
                 PlaceholderText="Senha atual" IsEnabled="{Binding !IsBusy}" />
        <TextBlock Text="*" FontSize="{DynamicResource DecorFontSizeCaption}" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorDangerBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,5,0"
                   ToolTip.Tip="Campo obrigatório" IsHitTestVisible="True" />
      </Grid>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <TextBox TabIndex="1" Text="{Binding NewPassword}" PasswordChar="●" Classes="revealPasswordButton"
               PlaceholderText="Nova senha" IsEnabled="{Binding !IsBusy}" />
      <TextBlock Text="*" FontSize="{DynamicResource DecorFontSizeCaption}" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorDangerBrush}"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,5,0"
                 ToolTip.Tip="Campo obrigatório" IsHitTestVisible="True" />
      <TextBlock Text="?" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,1,-22,0" FontSize="{DynamicResource DecorFontSizeSmall}" Foreground="{DynamicResource DecorTextMutedBrush}"
                 Cursor="Hand" TextAlignment="Center" PointerPressed="PasswordRequirements_OnPointerPressed" />
    </Grid>

    <StackPanel Grid.Row="3" Spacing="6">
      <Grid>
        <TextBox TabIndex="2" Text="{Binding ConfirmPassword}" PasswordChar="●" Classes="revealPasswordButton"
                 PlaceholderText="Confirme a nova senha" IsEnabled="{Binding !IsBusy}" />
        <TextBlock Text="*" FontSize="{DynamicResource DecorFontSizeCaption}" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorDangerBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,5,0"
                   ToolTip.Tip="Campo obrigatório" IsHitTestVisible="True" />
      </Grid>
    </StackPanel>

    <Border Grid.Row="4" Padding="10" Background="{DynamicResource DecorSurfaceRaisedBrush}"
            BorderBrush="{DynamicResource DecorDangerBrush}" BorderThickness="1" CornerRadius="4"
            IsVisible="{Binding HasError}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap" />
        <Button Grid.Column="1" TabIndex="4" Width="28" Height="28" Padding="0"
                ToolTip.Tip="Copiar mensagem de erro" IsVisible="{Binding CanCopyError}"
                Click="CopyErrorButton_OnClick">
          <PathIcon Width="16" Height="16"
                    Data="M8.25,2A2.25,2.25 0,0 0,6,4.25V13.75A2.25,2.25 0,0 0,8.25,16H8.5V14.5H8.25A0.75,0.75 0,0 1,7.5,13.75V4.25A0.75,0.75 0,0 1,8.25,3.5H17.75A0.75,0.75 0,0 1,18.5,4.25V5H20V4.25A2.25,2.25 0,0 0,17.75,2H8.25M11.25,7A2.25,2.25 0,0 0,9,9.25V19.75A2.25,2.25 0,0 0,11.25,22H19.75A2.25,2.25 0,0 0,22,19.75V9.25A2.25,2.25 0,0 0,19.75,7H11.25M11.25,8.5H19.75A0.75,0.75 0,0 1,20.5,9.25V19.75A0.75,0.75 0,0 1,19.75,20.5H11.25A0.75,0.75 0,0 1,10.5,19.75V9.25A0.75,0.75 0,0 1,11.25,8.5Z" />
        </Button>
      </Grid>
    </Border>

    <ProgressBar Grid.Row="5" IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />

    <Button Grid.Row="7" TabIndex="3" Content="Salvar" Command="{Binding ChangePasswordCommand}" IsDefault="True"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="170" MinHeight="36" Padding="12,8"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
  </Grid>
</Window>
