<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.SalesView"
             x:DataType="vm:SalesViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
    <Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
    <Grid ColumnDefinitions="*,36,36">
      <TextBox x:Name="SearchTextBox" Text="{Binding SearchText}" PlaceholderText="Pesquisar vendas por código" KeyDown="SearchTextBox_KeyDown" BorderThickness="0"/>
      <Button Grid.Column="1" Classes="search-button" Command="{Binding SearchCommand}" Margin="0" Padding="0" Width="36" MinWidth="36" Height="NaN" MinHeight="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="0" ToolTip.Tip="Pesquisar"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Search}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button>
      <Button Grid.Column="2" Classes="clear-search-button" Command="{Binding ClearSearchCommand}" Margin="0" Padding="0" Width="36" MinWidth="36" Height="NaN" MinHeight="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderThickness="0" CornerRadius="0" ToolTip.Tip="Limpar pesquisa"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Clear}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/></Button>
    </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
      <TextBox Width="150" Text="{Binding SectionIdInput}" PlaceholderText="Código da seção aprovada" VerticalContentAlignment="Center"/>
      <Button Grid.Column="1" Command="{Binding ConvertCommand}" IsVisible="{Binding CanConvert}"><StackPanel Orientation="Horizontal" Spacing="6"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/><TextBlock Text="Gerar venda"/></StackPanel></Button>
      <ToggleSwitch Grid.Column="2" Content="Exige entrada" IsChecked="{Binding RequiresDownPayment}" IsVisible="{Binding CanApprove}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="3" Spacing="2" IsVisible="{Binding CanApprove}"><TextBlock Text="Prazo de fabricação" FontSize="{DynamicResource DecorFontSizeCaption}"/><DatePicker SelectedDate="{Binding ManufacturingDeadline}"/></StackPanel>
      <StackPanel Grid.Column="4" Spacing="2" IsVisible="{Binding CanApprove}"><TextBlock Text="Prazo de instalação" FontSize="{DynamicResource DecorFontSizeCaption}"/><DatePicker SelectedDate="{Binding InstallationDeadline}"/></StackPanel>
      <Button Grid.Column="5" Command="{Binding ApproveCommand}" IsVisible="{Binding CanApprove}"><TextBlock Text="Aprovar"/></Button>
      <Button Grid.Column="6" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" Background="{DynamicResource DecorDangerBrush}" Foreground="White"><TextBlock Text="Cancelar venda"/></Button>
    </Grid>
    <Border Grid.Row="2" Padding="10" Margin="0,0,0,8" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorDangerBrush}" BorderThickness="1" IsVisible="{Binding HasError}" VerticalAlignment="Top" ZIndex="2">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
    </Border>
    <controls:DecorDataGridControl Grid.Row="2" x:Name="SalesGrid" PaginationSource="{Binding}" DefaultSortMemberPath="OrderID" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"/>
    <Border Grid.Row="3" Padding="12,10,12,0" Margin="0,10,0,0" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" IsVisible="{Binding HasSelectedOrder}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <TextBlock Text="Plano de pagamento" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><TextBlock Text="Total da venda:"/><TextBlock Text="{Binding SelectedOrderTotal, StringFormat='{}{0:C2}'}" FontWeight="{DynamicResource DecorFontWeightHeading}"/></StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"><TextBlock Text="Total das parcelas:"/><TextBlock Text="{Binding PaymentPlanTotal, StringFormat='{}{0:C2}'}" FontWeight="{DynamicResource DecorFontWeightHeading}"/></StackPanel>
        </Grid>
        <ListBox ItemsSource="{Binding Installments}" IsVisible="{Binding HasInstallmentPlan}" MinHeight="48" MaxHeight="120">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16" Margin="4">
                <TextBlock Text="{Binding InstallmentNumber, StringFormat='Parcela {0}'}"/>
                <TextBlock Grid.Column="1" Text="{Binding PaymentMethodID, StringFormat='Forma #{0}'}"/>
                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:C2}'}"/>
                <TextBlock Grid.Column="3" Text="{Binding DueDate, StringFormat='{}{0:d}'}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid ColumnDefinitions="*,140,170,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding CanConfigurePaymentPlan}">
          <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" PlaceholderText="Forma de pagamento">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Grid.Column="1" Text="{Binding InstallmentAmountInput}" PlaceholderText="Valor"/>
          <DatePicker Grid.Column="2" SelectedDate="{Binding InstallmentDueDate}"/>
          <Button Grid.Column="3" Command="{Binding AddInstallmentCommand}"><TextBlock Text="Adicionar parcela"/></Button>
          <Button Grid.Column="4" Command="{Binding RemoveInstallmentCommand}" IsVisible="{Binding HasSelectedPlanEntry}"><TextBlock Text="Remover"/></Button>
        </Grid>
        <ListBox ItemsSource="{Binding PlanEntries}" SelectedItem="{Binding SelectedPlanEntry}" IsVisible="{Binding CanConfigurePaymentPlan}" MinHeight="48" MaxHeight="120">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Margin="4">
                <TextBlock Text="{Binding PaymentMethodName}"/>
                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:C2}'}"/>
                <TextBlock Grid.Column="2" Text="{Binding DueDate, StringFormat='{}{0:d}'}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Command="{Binding CreatePaymentPlanCommand}" IsVisible="{Binding CanConfigurePaymentPlan}" HorizontalAlignment="Right"><TextBlock Text="Gravar plano de pagamento"/></Button>
      </StackPanel>
    </Border>
    <Panel Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource DecorOverlayBrush}" IsVisible="{Binding ShowCancelConfirmation}" ZIndex="1000">
      <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Background="{DynamicResource DecorSurfaceRaisedBrush}" Padding="24" CornerRadius="8"><StackPanel Spacing="16"><TextBlock Text="Cancelar venda" FontSize="{DynamicResource DecorFontSizeSection}"/><TextBlock Text="Confirma o cancelamento da venda selecionada?" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Button Content="Sim, cancelar" Background="{DynamicResource DecorDangerBrush}" Foreground="White" Command="{Binding ConfirmCancelCommand}"/><Button Grid.Column="1" Content="Voltar" Command="{Binding DismissCancelCommand}"/></Grid></StackPanel></Border>
    </Panel>
  </Grid>
</UserControl>