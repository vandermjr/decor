<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:dtos="using:Decor.Core.DTOs"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             x:Class="Decor.AvaloniaUI.Views.GroupsView"
             x:DataType="vm:GroupRegistrationViewModel">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Text="Cadastro de grupos de segurança" FontSize="{DynamicResource DecorFontSizeTitle}" TextWrapping="Wrap"/>
      <ProgressBar Grid.Column="1" Width="120" Height="6" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <controls:DecorSearchField x:Name="SearchTextBox" Text="{Binding SearchText, Mode=TwoWay}"
                  PlaceholderText="Pesquisar grupos por código, nome ou descrição"
                  SearchCommand="{Binding SearchCommand}" ClearCommand="{Binding ClearSearchCommand}"
                  IsVisible="{Binding !IsEditing}"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
        <Button Command="{Binding NewCommand}" IsVisible="{Binding !IsEditing}" Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Create}" Fill="{DynamicResource DecorAddIndicatorBrush}" Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Novo registro"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding EditCommand}" IsVisible="{Binding !IsEditing}" Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Edit}" Fill="{DynamicResource DecorEditIndicatorBrush}" Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Editar"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Panel Grid.Row="2">
      <controls:DecorDataGridControl x:Name="RolesGrid" PaginationSource="{Binding}" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                      IsVisible="{Binding !IsEditing}" DefaultSortMemberPath="RoleName"
                                      IsEnabled="{Binding IsIdle}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <Grid RowDefinitions="*,Auto" IsVisible="{Binding IsEditing}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding IsIdle}" VerticalAlignment="Top">
        <TextBlock Text="Nome" FontWeight="{DynamicResource DecorFontWeightBase}"/>
        <TextBox Grid.Row="1" Text="{Binding Name, Mode=TwoWay}" MaxLength="50" controls:DecorRequiredField.IsRequired="True"/>
        <TextBlock Grid.Row="2" Text="Descrição" FontWeight="{DynamicResource DecorFontWeightBase}"/>
        <TextBox Grid.Row="3" Text="{Binding Description, Mode=TwoWay}" MaxLength="255" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
      </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding SaveCommand}" Classes="decor-action">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{DynamicResource DecorAccentBrush}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Salvar"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" Classes="decor-action">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{DynamicResource DecorDangerBrush}" Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Cancelar"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
    </Panel>
    <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
               Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
  </Grid>
</UserControl>