<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:controls="using:Decor.AvaloniaUI.Controls"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.UserFormView"
             x:DataType="vm:UserFormViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding FormTitle}" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <Border Padding="12,8" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Código" FontWeight="{DynamicResource DecorFontWeightHeading}" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding UserCodeDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

            <ToggleSwitch IsChecked="{Binding IsActive, Mode=TwoWay}" OnContent="Ativo" OffContent="Bloqueado" MinWidth="135" IsEnabled="{Binding CanChangeActive}"/>
          </StackPanel>
      </Grid>
      </Border>
    </StackPanel>
    <ScrollViewer x:Name="FormScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" Margin="0,0,16,12">
        <StackPanel Spacing="4">
          <TextBlock Text="Usuário" FontWeight="{DynamicResource DecorFontWeightBase}"/>
          <TextBox x:Name="UsernameTextBox" Text="{Binding Username, Mode=TwoWay}" MaxLength="50" IsEnabled="{Binding CanEditFields}" controls:DecorRequiredField.IsRequired="True"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Funcionário vinculado (opcional)" FontWeight="{DynamicResource DecorFontWeightBase}"/>
          <Border Height="36" ClipToBounds="True" Background="{DynamicResource DecorControlBrush}"
                  BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding EmployeeName}" IsReadOnly="True" BorderThickness="0" Padding="10,0"
                       VerticalContentAlignment="Center" PlaceholderText="Nenhum funcionário vinculado"/>
              <Button Grid.Column="1" Classes="field-action decor-action" Command="{Binding ClearEmployeeCommand}"
                      IsVisible="{Binding HasEmployee}" IsEnabled="{Binding CanClearEmployee}" ToolTip.Tip="Remover vínculo">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Grid.Column="2" Classes="field-action decor-action" Click="SearchEmployee_Click"
                      IsEnabled="{Binding CanSelectEmployee}" ToolTip.Tip="Pesquisar funcionário">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Search}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
              </Button>
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Grupos associados" FontWeight="{DynamicResource DecorFontWeightBase}"/>
          <ListBox ItemsSource="{Binding Groups}" IsEnabled="{Binding CanEditGroups}"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="0,4">
            <ListBox.Styles>
              <!-- The global 23px item height clips the checkbox glyph and text. -->
              <Style Selector="ListBoxItem">
                <Setter Property="Height" Value="NaN"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="8,4"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EditUserRoleOption">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Role.RoleName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Role.Description}"/>
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <Border Padding="12" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorAccentBrush}" BorderThickness="1" IsVisible="{Binding HasTemporaryPassword}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap"/>
            <TextBlock Text="Senha temporária" FontWeight="{DynamicResource DecorFontWeightBase}"/>
            <SelectableTextBlock Text="{Binding TemporaryPassword}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Padding="10" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorDangerBrush}" BorderThickness="1" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <ProgressBar Width="100" Height="3" HorizontalAlignment="Left" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
        <Button Grid.Column="1" Command="{Binding DismissCommand}" Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{DynamicResource DecorDangerBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding DismissButtonText}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Command="{Binding SaveCommand}" IsVisible="{Binding !IsCompleted}" Classes="decor-action">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{DynamicResource DecorAccentBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="Salvar" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>