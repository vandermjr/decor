<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
             xmlns:icons="using:Decor.AvaloniaUI.Icons"
             x:Class="Decor.AvaloniaUI.Views.UserFormView"
             x:DataType="vm:UserFormViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding FormTitle}" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Padding="12,8" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Código" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding UserCodeDisplay}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Padding="12,4" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Estado" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
            <ToggleSwitch IsChecked="{Binding IsActive, Mode=TwoWay}" OnContent="Ativo" OffContent="Bloqueado" MinWidth="135" IsEnabled="{Binding CanChangeActive}"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
    <ScrollViewer x:Name="FormScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16" Margin="0,0,16,12">
        <StackPanel Spacing="4">
          <TextBlock Text="Usuário" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          <TextBox x:Name="UsernameTextBox" Text="{Binding Username, Mode=TwoWay}" MaxLength="50" IsEnabled="{Binding CanEditFields}"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="Grupos associados" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          <ListBox ItemsSource="{Binding Groups}" IsEnabled="{Binding CanEditGroups}"
                   ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" Padding="0,4">
            <ListBox.Styles>
              <!-- The global 23px item height clips the checkbox glyph and text. -->
              <Style Selector="ListBoxItem">
                <Setter Property="Height" Value="NaN"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="8,4"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EditUserRoleOption">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Role.RoleName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Role.Description}"/>
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <Border Padding="12" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorAccentBrush}" BorderThickness="1" IsVisible="{Binding HasTemporaryPassword}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SuccessMessage}" TextWrapping="Wrap"/>
            <TextBlock Text="Senha temporária" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
            <SelectableTextBlock Text="{Binding TemporaryPassword}" FontSize="{DynamicResource DecorFontSizeSection}" FontWeight="{DynamicResource DecorFontWeightHeading}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Padding="10" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorDangerBrush}" BorderThickness="1" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DecorDangerBrush}" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <ProgressBar Width="100" Height="3" HorizontalAlignment="Left" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
        <Button Grid.Column="1" Command="{Binding DismissCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Cancel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding DismissButtonText}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Command="{Binding SaveCommand}" IsVisible="{Binding !IsCompleted}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Save}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Text="Salvar" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>