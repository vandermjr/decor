<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Decor.AvaloniaUI.Views.UserOptionsView"
             >
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
      <TextBlock Text="Preferências" FontSize="{DynamicResource DecorFontSizeTitle}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
      <TextBlock Text="Nenhuma preferência pessoal está disponível no momento." Foreground="{DynamicResource DecorTextMutedBrush}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>