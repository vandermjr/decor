<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Decor.AvaloniaUI.Controls.DecorDataGridControl"
    x:Name="Root">
    
    <Grid ColumnDefinitions="*" RowDefinitions="*"> 
        <!-- Main DataGrid -->
        <DataGrid x:Name="InnerDataGrid"
                  ItemsSource="{Binding ItemsSource, ElementName=Root}"
                  SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  RowHeight="23"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"/>

        <!-- Empty Grid Overlay -->
        <Panel x:Name="EmptyOverlay"
             Background="{DynamicResource ThemeControlLowBrush}"
               IsVisible="False"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Stretch">
            <TextBlock x:Name="EmptyMessageTextBlock"
                       Text="Não há registros para exibir."
                       FontSize="{DynamicResource DecorFontSizeBase}"
                       FontStyle="Italic"
                       Foreground="{DynamicResource DecorTextMutedBrush}"
                       Opacity="0.65"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Panel>
    </Grid>
    
</UserControl>
