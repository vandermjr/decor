<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
        xmlns:icons="using:Decor.AvaloniaUI.Icons"
        x:Class="Decor.AvaloniaUI.MainWindow"
        Title="Decor"
        Width="1200"
        Height="800"
        x:DataType="vm:MainViewModel">
  <Window.Resources>
    <Flyout x:Key="NotificationsFlyout" Placement="BottomEdgeAlignedRight" ShowMode="Transient">
      <Border Padding="14" MinWidth="260" Background="{DynamicResource DecorSurfaceRaisedBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="Notificações" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
          <Border Padding="10" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="Nenhuma notificação" Foreground="{DynamicResource DecorTextMutedBrush}"/>
          </Border>
        </StackPanel>
      </Border>
    </Flyout>
    <Flyout x:Key="UserFlyout" Placement="BottomEdgeAlignedRight" ShowMode="Transient">
      <Border MinWidth="300" MaxWidth="360" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <Border Padding="16,14" Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource DecorAccentBrush}">
                <TextBlock Text="{Binding UserInitials}" Foreground="{DynamicResource DecorSelectionForegroundBrush}" FontSize="16" FontWeight="{DynamicResource DecorFontWeightHeading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding UserPresentationName}" FontWeight="{DynamicResource DecorFontWeightHeading}" FontSize="15" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Margin="4,6,4,4" Spacing="0">
            <Button Classes="user-flyout-action" IsEnabled="False">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Profile}" Fill="{DynamicResource DecorTextMutedBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Minha Conta" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Classes="user-flyout-action" Command="{Binding ShowUserOptionsCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Preferences}" Stroke="{DynamicResource DecorTextMutedBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Preferências" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Classes="user-flyout-action" Command="{Binding ChangePasswordCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.ChangePassword}" Stroke="{DynamicResource DecorTextMutedBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Alterar senha" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource DecorBorderBrush}"/>

          <Grid ColumnDefinitions="*,Auto">
            <Button Classes="user-flyout-action user-flyout-logout" Command="{Binding SignOutCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.SignOut}" Stroke="{DynamicResource DecorTextMutedBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Sair" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,14,0" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource DecorAccentBrush}"/>
              <TextBlock Text="Online" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Flyout>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.top-menu-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.notification-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.notification-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
    </Style>
    <Style Selector="Button.user-profile-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.user-profile-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
    </Style>
    <Style Selector="Button.theme-selector-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.theme-selector-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
    </Style>
    <Style Selector="Button.user-flyout-action">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.user-flyout-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
    </Style>
    <Style Selector="Button.user-flyout-action:disabled">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Button.user-flyout-logout">
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="MinHeight" Value="48"/>
    </Style>
    <Style Selector="Menu.top-menu > MenuItem">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.main-menu-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.main-menu-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource DecorSurfaceBrush}"
            BorderBrush="{DynamicResource DecorBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="MainMenuRegistrationsButton" Classes="main-menu-button" Content="Cadastros">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Produtos" Command="{Binding ShowProductsCommand}"/>
                <MenuItem Header="Marcas" Command="{Binding ShowBrandsCommand}"/>
                <MenuItem Header="Funcionários" Command="{Binding ShowEmployeesCommand}" IsVisible="{Binding CanViewEmployees}"/>
                <MenuItem Header="Classificações" Command="{Binding ShowClassificationsCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="main-menu-button" Content="Comercial">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Orçamentos" IsEnabled="False"/>
                <MenuItem Header="Pedidos" IsEnabled="False"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="main-menu-button" Content="Compras">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Pedidos de Compra" IsEnabled="False"/>
                <MenuItem Header="Recebimentos" IsEnabled="False"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="main-menu-button" Content="Estoque">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Estoque" IsEnabled="False"/>
                <MenuItem Header="Transferências" IsEnabled="False"/>
                <MenuItem Header="Ajustes" IsEnabled="False"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="main-menu-button" Content="Serviços">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Agenda" IsEnabled="False"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="main-menu-button" Content="Financeiro">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Contas a Pagar" IsEnabled="False"/>
                <MenuItem Header="Caixa" IsEnabled="False"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="main-menu-button" Content="Configurações">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Configurações do Sistema" Command="{Binding ShowSystemSettingsCommand}" IsVisible="{Binding CanViewSystemSettings}"/>
                <MenuItem Header="Usuários" Command="{Binding ShowUsersCommand}" IsVisible="{Binding CanViewUsers}"/>
                <MenuItem Header="Grupos de Permissões" Command="{Binding ShowRolesCommand}" IsVisible="{Binding CanViewRoles}"/>
                <MenuItem Header="Administração do Sistema" Command="{Binding ShowDatabaseMaintenanceCommand}" IsVisible="{Binding CanViewDatabaseMaintenance}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="main-menu-button" Content="Ajuda">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Sobre o Sistema" IsEnabled="False"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <Border Width="1" Height="20" Margin="4,0,4,0" Background="{DynamicResource DecorBorderBrush}" VerticalAlignment="Center"/>
          <Button Classes="theme-selector-button" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToolTip}">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Application.ThemeToggle}"
                  Fill="{DynamicResource DecorTextBrush}"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"/>
          </Button>
          <Button x:Name="NotificationsButton"
                  Classes="notification-button"
                  Cursor="Hand"
                  ToolTip.Tip="Notificações"
                  Click="NotificationsButton_Click">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Notifications}"
                  Fill="{DynamicResource DecorTextBrush}"
                  Width="16"
                  Height="18"
                  Stretch="Uniform"/>
          </Button>
          <Button Classes="user-profile-button"
                  Cursor="Hand"
                  ToolTip.Tip="{Binding UserPresentationName, FallbackValue=Conta}"
                  Click="UserButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource DecorAccentBrush}">
                <TextBlock Text="{Binding UserInitials}" Foreground="{DynamicResource DecorSelectionForegroundBrush}" FontSize="{DynamicResource DecorFontSizeSmall}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{Binding UserPresentationName}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <Path Data="M 4,7 L 8,11 L 12,7" Stroke="{DynamicResource DecorTextMutedBrush}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*">
      <Grid Grid.Column="0" RowDefinitions="Auto,*">
      <StackPanel Grid.RowSpan="2" IsVisible="{Binding IsHomeVisible}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="Bem-vindo ao Decor"
                   FontSize="{DynamicResource DecorFontSizeDisplay}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Selecione uma opção no menu para começar."
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <Border Grid.Row="0"
              Height="37"
              Background="{DynamicResource DecorWindowBackgroundBrush}"
          ClipToBounds="False"
              IsVisible="{Binding HasOpenDocuments}">
        <Grid>
          <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource DecorBorderBrush}"/>
          <ItemsControl ItemsSource="{Binding OpenDocuments}" ZIndex="1">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WorkspaceDocumentViewModel">
            <Border Height="37"
                  Background="{DynamicResource DecorSurfaceBrush}"
                    BorderBrush="{DynamicResource DecorBorderBrush}"
                    BorderThickness="0,0,1,0"
                  ClipToBounds="False"
                  Cursor="Hand"
                    PointerEntered="DocumentTab_PointerEntered"
                    PointerExited="DocumentTab_PointerExited"
                    PointerPressed="DocumentTab_PointerPressed">
              <Grid RowDefinitions="1,*" ColumnDefinitions="Auto,28" ColumnSpacing="7">
                <Border Grid.ColumnSpan="2" Background="{DynamicResource DecorAccentBrush}" IsVisible="{Binding IsActive}"/>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource DecorWindowBackgroundBrush}" IsVisible="{Binding IsHighlighted}" Margin="0,0,0,1"/>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource DecorWindowBackgroundBrush}" IsVisible="{Binding IsActive}" Margin="0,0,0,-1"/>
                <TextBlock Grid.Row="1"
                           Margin="12,0,0,0"
                           Text="{Binding Title}"
                           Foreground="{DynamicResource DecorTextBrush}"
                           VerticalAlignment="Center"/>
                <Ellipse Grid.Row="1" Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource DecorAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowModificationIndicator}"/>
                <Button Grid.Row="1" Grid.Column="1"
                        Width="18"
                        Height="18"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="x"
                        FontSize="{DynamicResource DecorFontSizeCaption}"
                        Margin="0"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        IsVisible="{Binding ShowCloseButton}"
                        ToolTip.Tip="Fechar aba"
                        Command="{Binding CloseCommand}"/>
              </Grid>
            </Border>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding ActiveDocument.Content}" />
    </Grid>
    </Grid>
    <Border Grid.Row="2" Classes="status-bar" Padding="8,5" Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPaginationVisible}" VerticalAlignment="Center">
          <TextBlock Text="Tamanho da página:" Foreground="{DynamicResource DecorTextMutedBrush}" VerticalAlignment="Center"/>
          <ComboBox ItemsSource="{Binding StatusSource.PageSizeOptions}"
                    SelectedItem="{Binding StatusSource.SelectedPageSize, Mode=TwoWay}"
                    MinWidth="76"
                    ToolTip.Tip="Registros por página"/>
          <TextBlock Text="{Binding StatusSource.PaginationStatus}" Margin="34,0,18,0" Foreground="{DynamicResource DecorTextBrush}" VerticalAlignment="Center"/>
          <Button x:Name="StatusBarFirstPageButton" Classes="pagination-button" IsEnabled="{Binding StatusSource.HasFirstPage}" Command="{Binding StatusSource.FirstPageCommand}" Padding="5,3" MinWidth="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Primeira página">
            <Path Data="M 16,5 L 9,12 L 16,19 Z M 6,5 L 6,19" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="14" Stretch="Uniform"/>
          </Button>
          <Button Classes="pagination-button" IsEnabled="{Binding StatusSource.HasPreviousPage}" Command="{Binding StatusSource.PreviousPageCommand}" Padding="5,3" MinWidth="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Página anterior">
            <Path Data="M 17,5 L 9,12 L 17,19 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="14" Stretch="Uniform"/>
          </Button>
          <TextBlock Text="{Binding StatusSource.PaginationPageStatus}" Margin="10,0,10,0" Foreground="{DynamicResource DecorTextBrush}" VerticalAlignment="Center"/>
          <Button Classes="pagination-button" IsEnabled="{Binding StatusSource.HasNextPage}" Command="{Binding StatusSource.NextPageCommand}" Padding="5,3" MinWidth="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Próxima página">
            <Path Data="M 7,5 L 15,12 L 7,19 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="14" Stretch="Uniform"/>
          </Button>
          <Button Classes="pagination-button" IsEnabled="{Binding StatusSource.HasLastPage}" Command="{Binding StatusSource.LastPageCommand}" Padding="5,3" MinWidth="30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Última página">
            <Path Data="M 8,5 L 15,12 L 8,19 Z M 18,5 L 18,19" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="14" Stretch="Uniform"/>
          </Button>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding StatusSource.StatusMessage}" Foreground="{DynamicResource DecorTextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="4" Text="{Binding StatusSource.StatusSecondary}" IsVisible="{Binding StatusSource.HasStatusSecondary}" Foreground="{DynamicResource DecorAccentBrush}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
