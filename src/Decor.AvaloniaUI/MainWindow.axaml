<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Decor.AvaloniaUI.ViewModels"
        xmlns:icons="using:Decor.AvaloniaUI.Icons"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="Decor.AvaloniaUI.MainWindow"
        Title="Decor"
        Width="1200"
        Height="800"
        x:DataType="vm:MainViewModel">
  <Window.Resources>
    <Flyout x:Key="NotificationsFlyout" Placement="BottomEdgeAlignedRight" ShowMode="Transient">
      <Border Padding="14" MinWidth="320" MaxWidth="420" Background="{DynamicResource DecorSurfaceRaisedBrush}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="Notificações" FontWeight="{DynamicResource DecorFontWeightHeading}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Limpar" Command="{Binding ClearNotificationsCommand}" IsVisible="{Binding HasNotifications}" Classes="decor-action"/>
            <Button Grid.Column="2" Classes="decor-flyout-close" Click="CloseNotificationsFlyout_Click" ToolTip.Tip="Fechar"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/></Button>
          </Grid>
          <TextBlock Text="Nenhuma notificação" Foreground="{DynamicResource DecorTextMutedBrush}" IsVisible="{Binding !HasNotifications}"/>
          <ScrollViewer MaxHeight="360" IsVisible="{Binding HasNotifications}">
            <ItemsControl ItemsSource="{Binding Notifications}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,6" Padding="10" Background="{DynamicResource DecorControlBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontWeight="{DynamicResource DecorFontWeightHeading}"/>
                      <TextBlock Text="{Binding Message}" Foreground="{DynamicResource DecorTextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Flyout>
    <Flyout x:Key="UserFlyout" Placement="BottomEdgeAlignedRight" ShowMode="Transient">
      <Border MinWidth="300" MaxWidth="360" Background="{DynamicResource DecorSurfaceRaisedBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <Border Padding="16,14" Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource DecorAccentBrush}">
                <TextBlock Text="{Binding UserInitials}" Foreground="{DynamicResource DecorSelectionForegroundBrush}" FontSize="16" FontWeight="{DynamicResource DecorFontWeightHeading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding UserPresentationName}" FontWeight="{DynamicResource DecorFontWeightHeading}" FontSize="15" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="2" Classes="decor-flyout-close" Click="CloseUserFlyout_Click" ToolTip.Tip="Fechar"><Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}" Fill="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/></Button>
            </Grid>
          </Border>

          <StackPanel Margin="4,6,4,4" Spacing="0">
            <Button Classes="user-flyout-action" IsEnabled="False">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Profile}" Fill="{DynamicResource DecorTextMutedBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Minha Conta" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Classes="user-flyout-action" Command="{Binding ShowUserOptionsCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Preferences}" Fill="{DynamicResource DecorTextMutedBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Preferências" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button Classes="user-flyout-action" Command="{Binding ChangePasswordCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.ChangePassword}" Fill="{DynamicResource DecorTextMutedBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Alterar senha" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource DecorBorderBrush}"/>

          <Grid ColumnDefinitions="*,Auto">
            <Button Classes="user-flyout-action user-flyout-logout" Command="{Binding SignOutCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.SignOut}" Fill="{DynamicResource DecorTextMutedBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Sair" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,14,0" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource DecorAccentBrush}"/>
              <TextBlock Text="Online" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeCaption}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Flyout>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="PathIcon.menu-icon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.top-menu-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.notification-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.notification-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
    </Style>
    <Style Selector="Button.user-profile-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="7,3"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.user-profile-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
    </Style>
    <Style Selector="Button.theme-selector-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.theme-selector-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
    </Style>
    <Style Selector="Button.user-flyout-action">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.user-flyout-action:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
    </Style>
    <Style Selector="Button.user-flyout-action:disabled">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Opacity" Value="0.6"/>
    </Style>
    <Style Selector="Button.user-flyout-logout">
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="MinHeight" Value="48"/>
    </Style>
    <Style Selector="Button.main-menu-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.main-menu-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource DecorControlBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DecorBorderBrush}"/>
      <Setter Property="CornerRadius" Value="3"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource DecorMenuBackgroundBrush}"
            BorderBrush="{DynamicResource DecorBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <Menu Classes="top-menu">
          <MenuItem Classes="main-menu-category" Header="Cadastros">
                <MenuItem Classes="submenu-item" Header="Produtos" Command="{Binding ShowProductsCommand}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.Products}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Marcas" Command="{Binding ShowBrandsCommand}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.Brands}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Unidades de medida" Command="{Binding ShowUnitsOfMeasureCommand}"
                          IsVisible="{Binding CanViewUnitsOfMeasure}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.Classifications}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Clientes" Command="{Binding ShowCustomersCommand}" IsVisible="{Binding CanViewCustomers}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Profile}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Fornecedores" Command="{Binding ShowSuppliersCommand}" IsVisible="{Binding CanViewSuppliers}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Modules.Compras}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Parceiros" Command="{Binding ShowPartnersCommand}" IsVisible="{Binding CanViewPartners}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Profile}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Funcionários" Command="{Binding ShowEmployeesCommand}" IsVisible="{Binding CanViewEmployees}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Profile}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Classificações" Command="{Binding ShowClassificationsCommand}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.Classifications}"/></MenuItem.Icon>
                </MenuItem>
          </MenuItem>
          <MenuItem Classes="main-menu-category" Header="Comercial">
                <MenuItem Classes="submenu-item" Header="Orçamentos" Command="{Binding ShowQuotesCommand}" IsVisible="{Binding CanViewQuotes}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Report}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Vendas" Command="{Binding ShowSalesCommand}" IsVisible="{Binding CanViewSales}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Modules.Comercial}"/></MenuItem.Icon>
                </MenuItem>
          </MenuItem>
          <MenuItem Classes="main-menu-category" Header="Compras">
                <MenuItem Classes="submenu-item" Header="Pedidos de Compra" Command="{Binding ShowPurchaseOrdersCommand}" IsVisible="{Binding CanViewPurchaseOrders}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Modules.Compras}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Recebimentos" Command="{Binding ShowGoodsReceiptsCommand}" IsVisible="{Binding CanViewGoodsReceipts}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.TermDelivery}"/></MenuItem.Icon>
                </MenuItem>
          </MenuItem>
          <MenuItem Classes="main-menu-category" Header="Estoque">
                <MenuItem Classes="submenu-item" Header="Estoque" Command="{Binding ShowStockCommand}" IsVisible="{Binding CanViewStock}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Modules.Estoque}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Transferências" Command="{Binding ShowStockTransfersCommand}" IsVisible="{Binding CanViewStockTransfers}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.TermDelivery}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Ajustes" Command="{Binding ShowStockAdjustmentsCommand}" IsVisible="{Binding CanViewStockAdjustments}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Preferences}"/></MenuItem.Icon>
                </MenuItem>
          </MenuItem>
          <MenuItem Classes="main-menu-category" Header="Serviços">
                <MenuItem Classes="submenu-item" Header="Serviços" Command="{Binding ShowServicesCommand}" IsVisible="{Binding CanViewServices}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Modules.Servicos}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Agenda" IsEnabled="False">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Common.Calendar}"/></MenuItem.Icon>
                </MenuItem>
          </MenuItem>
          <MenuItem Classes="main-menu-category" Header="Financeiro">
                <MenuItem Classes="submenu-item" Header="Contas a Pagar" IsEnabled="False">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Report}"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Caixa" IsEnabled="False">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Modules.Financeiro}"/></MenuItem.Icon>
                </MenuItem>
          </MenuItem>
          <MenuItem Classes="main-menu-category" Header="Ferramentas">
                <MenuItem Classes="submenu-item" Header="Acessos" IsVisible="{Binding CanViewAccess}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.PermissionGroups}"/></MenuItem.Icon>
                  <MenuItem Classes="submenu-item" Header="Usuários" Command="{Binding ShowUsersCommand}" IsVisible="{Binding CanViewUsers}">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.Users}"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Classes="submenu-item" Header="Grupos" Command="{Binding ShowRolesCommand}" IsVisible="{Binding CanViewRoles}">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.PermissionGroups}"/></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Classes="submenu-item" Header="Permissões" Command="{Binding ShowPermissionsCommand}" IsVisible="{Binding CanViewPermissions}">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.Permissions}"/></MenuItem.Icon>
                  </MenuItem>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Manutenção do banco de dados" IsVisible="{Binding CanViewDatabaseMaintenance}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.DatabaseMaintenance}"/></MenuItem.Icon>
                  <MenuItem Classes="submenu-item" Header="Backup e restauração" Command="{Binding ShowDatabaseMaintenanceCommand}">
                    <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Forms.DatabaseMaintenance}"/></MenuItem.Icon>
                  </MenuItem>
                </MenuItem>
                <MenuItem Classes="submenu-item" Header="Opções" Command="{Binding ShowSystemSettingsCommand}" IsVisible="{Binding CanViewSystemSettings}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Application.Settings}"/></MenuItem.Icon>
                </MenuItem>
          </MenuItem>
          <MenuItem Classes="main-menu-category" Header="Ajuda">
                <MenuItem Classes="submenu-item" Header="Sobre o Sistema" Command="{Binding ShowAboutCommand}">
                  <MenuItem.Icon><PathIcon Classes="menu-icon" icons:DecorIcon.Id="{x:Static icons:DecorIconId+Application.Info}"/></MenuItem.Icon>
                </MenuItem>
          </MenuItem>
        </Menu>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
          <Border Width="1" Height="20" Margin="4,0,4,0" Background="{DynamicResource DecorBorderBrush}" VerticalAlignment="Center"/>
          <Button Classes="theme-selector-button" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="{Binding ThemeToolTip}">
            <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Application.ThemeToggle}"
                  Fill="{DynamicResource DecorTextBrush}"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"/>
          </Button>
          <Button x:Name="NotificationsButton"
                  Classes="notification-button"
                  Cursor="Hand"
                  ToolTip.Tip="Notificações"
                  Click="NotificationsButton_Click">
            <Grid Width="24" Height="24">
              <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+User.Notifications}"
                    Fill="{DynamicResource DecorTextBrush}"
                    Width="16"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"/>
              <Border HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="14" Height="14" Padding="2,0" CornerRadius="7" Background="{DynamicResource DecorDangerBrush}" IsVisible="{Binding HasNotifications}">
                <TextBlock Text="{Binding NotificationCountText}" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Button>
          <Button Classes="user-profile-button"
                  Cursor="Hand"
                  ToolTip.Tip="{Binding UserPresentationName, FallbackValue=Conta}"
                  Click="UserButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource DecorAccentBrush}">
                <TextBlock Text="{Binding UserInitials}" Foreground="{DynamicResource DecorSelectionForegroundBrush}" FontSize="{DynamicResource DecorFontSizeSmall}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="{Binding UserPresentationName}" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <Path icons:DecorIcon.Id="{x:Static icons:DecorIconId+Navigation.Dropdown}" Fill="{DynamicResource DecorTextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="*">
      <Grid Grid.Column="0" RowDefinitions="Auto,*">
      <StackPanel Grid.RowSpan="2" IsVisible="{Binding IsHomeVisible}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock Text="Bem-vindo ao Decor"
                   FontSize="{DynamicResource DecorFontSizeDisplay}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Selecione uma opção no menu para começar."
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <Border Grid.Row="0"
              Height="37"
              Background="{DynamicResource DecorWindowBackgroundBrush}"
              ClipToBounds="False"
              IsVisible="{Binding HasOpenDocuments}">
        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0">
          <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource DecorBorderBrush}" Grid.ColumnSpan="3"/>
          <Button Grid.Column="0"
                  Name="DocumentTabsScrollLeft"
              Classes="grid-page-button"
              Margin="2,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Abas anteriores"
                  Click="DocumentTabsScrollLeft_Click">
            <PathIcon Width="16" Height="16"
                     icons:DecorIcon.Id="{x:Static icons:DecorIconId+Navigation.PreviousPage}"
                 Foreground="{DynamicResource DecorTextBrush}"
                     icons:DecorIcon.Weight="400"/>
          </Button>
          <Button Grid.Column="1"
            Name="DocumentTabsScrollRight"
            Classes="grid-page-button"
            Margin="2,0"
            VerticalAlignment="Center"
            ToolTip.Tip="Próximas abas"
            Click="DocumentTabsScrollRight_Click">
            <PathIcon Width="16" Height="16"
               icons:DecorIcon.Id="{x:Static icons:DecorIconId+Navigation.NextPage}"
               Foreground="{DynamicResource DecorTextBrush}"
               icons:DecorIcon.Weight="400"/>
          </Button>
          <ScrollViewer Grid.Column="2"
                        Name="DocumentTabsScroller"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        ScrollChanged="DocumentTabsScroller_ScrollChanged"
                        BringIntoViewOnFocusChange="False"
                        Padding="2,0">
            <Border BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="1,0,0,0">
            <ItemsControl ItemsSource="{Binding OpenDocuments}" ZIndex="1">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkspaceDocumentViewModel">
                  <Border Height="37"
                          MinWidth="110"
                          MaxWidth="220"
                          Background="{DynamicResource DecorSurfaceBrush}"
                          BorderBrush="{DynamicResource DecorBorderBrush}"
                          BorderThickness="0,0,1,0"
                          CornerRadius="4,4,0,0"
                          ClipToBounds="False"
                          Cursor="Hand"
                          ToolTip.Tip="{Binding Title}"
                          PointerEntered="DocumentTab_PointerEntered"
                          PointerExited="DocumentTab_PointerExited"
                          PointerPressed="DocumentTab_PointerPressed">
                    <Grid RowDefinitions="2,*" ColumnDefinitions="Auto,28" ColumnSpacing="7">
                      <Border Grid.ColumnSpan="2" Background="{DynamicResource DecorAccentBrush}" CornerRadius="4,4,0,0" IsVisible="{Binding IsActive}"/>
                      <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource DecorWindowBackgroundBrush}" IsVisible="{Binding IsHighlighted}" Margin="0,0,0,1"/>
                      <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource DecorWindowBackgroundBrush}" IsVisible="{Binding IsActive}" Margin="0,0,0,-1"/>
                      <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource DecorBorderBrush}" VerticalAlignment="Bottom" IsVisible="{Binding !IsActive}"/>
                      <StackPanel Grid.Row="1" Margin="12,0,0,0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" MinWidth="0">
                        <PathIcon Width="16" Height="16" Foreground="{DynamicResource DecorTextBrush}"
                                  icons:DecorIcon.Id="{Binding IconId}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource DecorTextBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150"/>
                      </StackPanel>
                      <Ellipse Grid.Row="1" Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource DecorEditIndicatorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowModificationIndicator}"/>
                      <Ellipse Grid.Row="1" Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource DecorAddIndicatorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowAdditionIndicator}"/>
                      <Button Grid.Row="1" Grid.Column="1"
                              Width="18"
                              Height="18"
                              MinWidth="18"
                              MinHeight="18"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              Margin="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              IsVisible="{Binding ShowCloseButton}"
                              ToolTip.Tip="Fechar aba"
                              Command="{Binding CloseCommand}">
                        <PathIcon Width="10" Height="10"
                                  icons:DecorIcon.Id="{x:Static icons:DecorIconId+Actions.Close}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Border>
          </ScrollViewer>
        </Grid>
      </Border>

      <ItemsControl Grid.Row="1"
                    ItemsSource="{Binding OpenDocuments}"
                    IsVisible="{Binding HasOpenDocuments}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WorkspaceDocumentViewModel">
            <ContentControl Content="{Binding Content}"
                            IsVisible="{Binding IsActive}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
    </Grid>
    <Border Grid.Row="2" Classes="status-bar" Height="24" Padding="3,0" Background="{DynamicResource DecorSurfaceBrush}" BorderBrush="{DynamicResource DecorBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
        <TextBlock Text="{Binding StatusSource.PaginationStatus}" IsVisible="{Binding IsPaginationVisible}" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeBase}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding StatusSource.StatusMessage}" IsVisible="{Binding !IsPaginationVisible}" Margin="12,0,0,0" Foreground="{DynamicResource DecorTextMutedBrush}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource DecorFontSizeBase}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding StatusSource.StatusSecondary}" IsVisible="{Binding StatusSource.HasStatusSecondary}" Foreground="{DynamicResource DecorTextMutedBrush}" FontSize="{DynamicResource DecorFontSizeBase}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
